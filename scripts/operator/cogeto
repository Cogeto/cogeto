#!/usr/bin/env bash
# cogeto — the Cogeto operator script (roadmap D3).
#
# The single tool an operator runs BY HAND on a fresh OVHcloud Ubuntu instance
# to install, configure, upgrade, and check a customer instance. Operations are
# script-driven and manual-by-design: no Terraform, no cloud-provider API
# automation, no self-serve provisioning, no automatic updates.
#
#   cogeto install    [--domain D] [--acme-email E] [--version X.Y.Z]
#   cogeto configure  [--domain D] [--regenerate NAME] [--mail-tls-mode MODE]
#   cogeto upgrade    [X.Y.Z|latest]
#   cogeto status
#   cogeto features   [enable <id> | disable <id>]
#   cogeto reindex    [--provider LABEL --model MODEL]
#   cogeto backup-info
#
# This script installs and operates INFRASTRUCTURE. It knows nothing about
# models: providers, models and their API keys are configured in the
# interface (Providers in the left rail) and stored in the instance
# database, encrypted under COGETO_MASTER_KEY.
#
# Global flags: --check (dry run: validate prerequisites, print the intended
# actions and the checklist, mutate NOTHING), --help, --root DIR.
#
# Design rules:
#   • The instance PULLS the prebuilt, cosign-signed release images and NEVER
#     builds: cogeto/cogeto, cogeto/cogeto-edge and cogeto/cogeto-mail always,
#     plus cogeto/cogeto-redaction when the redaction capability is on — this
#     script pulls and cosign-verifies that fourth image too (instance_images).
#   • Idempotent where possible — safe to re-run; every destructive or
#     irreversible action requires an explicit typed confirmation.
#   • Secrets are generated locally into a 600-permission .env and are never
#     committed, transmitted, or logged (names are logged, values never).
#   • Whatever the script cannot do itself is printed as a precise,
#     instance-specific "WHAT YOU MUST DO NOW" checklist at the end of the run.
#   • Supported OS: Ubuntu 22.04 LTS and 24.04 LTS, amd64.
#
# Developer notes: docs/operations/operator-script.md. Tests (usage, --check, pure
# helpers): project/src/entrypoints/operator-script.spec.ts. Keep this file
# clean under shellcheck (CI lint job) and bash-3.2-compatible (the spec also
# runs it on macOS): no associative arrays, no ${var,,}, no mapfile.

set -euo pipefail

# ── Constants ─────────────────────────────────────────────────────────────────

# Version policy lives on GitHub Releases: the newest release
# NOT flagged "pre-release" installs by default, and flagged releases are
# retired — this script refuses them. No pinned version constants to bump.

IMAGE="cogeto/cogeto"
IMAGE_EDGE="cogeto/cogeto-edge"
IMAGE_MAIL="cogeto/cogeto-mail"
# The redaction sidecar (issue #565). Published, signed and attested like the
# other three since that change; pulled and verified only when the capability
# is on, because an instance that does not redact never runs it.
IMAGE_REDACTION="cogeto/cogeto-redaction"
# cosign is installed by `install` (o6-dry-run: an optional verifier gets
# skipped in practice). Pinned release; single static binary, not in apt.
COSIGN_VERSION="2.4.1"
# SEC-13: the sha256 of cosign-linux-amd64 for the pinned release, taken from
# the release's own cosign_checksums.txt and HARD-PINNED HERE.
#
# Pinned rather than fetched, deliberately. The whole image-provenance chain
# terminates in this binary, so verifying it against a file downloaded from the
# same place at the same moment proves nothing: whoever could swap the binary
# could swap the checksum file beside it. This constant travels with the script
# the operator obtained over TLS, so replacing it means editing the script in
# the repository, which is a reviewed change. Bump both lines together.
COSIGN_SHA256="8b24b946dd5809c6bd93de08033bcf6bc0ed7d336b7785787c080f574b89249b"
GITHUB_REPO="Cogeto/cogeto"
GH_RELEASES_API="https://api.github.com/repos/${GITHUB_REPO}/releases"
HUB_API="https://hub.docker.com/v2/repositories"

COGETO_ROOT="${COGETO_ROOT:-/srv/cogeto}"
SERVICE_USER="cogeto"
SUPPORTED_UBUNTU="22.04 24.04"
MIN_RAM_MB=7000   # an 8 GB instance reports ~7.6 GiB
MIN_DISK_GB=30    # free space on the filesystem holding /var/lib/docker
MIN_CPUS=2

CHECK=0           # --check: dry run, mutate nothing
SAY_PREFIX="cogeto:"

# Checklist accumulators (printed by print_checklist at the end of every run).
TODO_NOW=()
TODO_AFTER_DNS=()
TODO_VAULT=()

# ── Output helpers ────────────────────────────────────────────────────────────

say()  { printf '%s %s\n' "$SAY_PREFIX" "$*"; }
warn() { printf '%s WARNING: %s\n' "$SAY_PREFIX" "$*" >&2; }
die()  { printf '%s ERROR: %s\n' "$SAY_PREFIX" "$*" >&2; exit 1; }

# Run a MUTATING command — in --check mode it is printed, not executed.
run() {
  if [ "$CHECK" -eq 1 ]; then
    printf '%s [dry-run] would run: %s\n' "$SAY_PREFIX" "$*"
    return 0
  fi
  "$@"
}

# Typed confirmation for destructive / irreversible actions. Never a default:
# the operator must type the exact phrase. --check mode skips (nothing mutates).
confirm_typed() {
  phrase="$1"; reason="$2"
  if [ "$CHECK" -eq 1 ]; then
    say "[dry-run] would ask you to type '${phrase}' to confirm: ${reason}"
    return 0
  fi
  printf '%s %s\n' "$SAY_PREFIX" "$reason"
  printf "%s type '%s' to proceed (anything else aborts): " "$SAY_PREFIX" "$phrase"
  IFS= read -r answer
  [ "$answer" = "$phrase" ] || die "not confirmed — nothing was changed"
}

todo_now()   { TODO_NOW+=("$1"); }
todo_dns()   { TODO_AFTER_DNS+=("$1"); }
todo_vault() { TODO_VAULT+=("$1"); }

print_checklist() {
  echo
  echo "══════════════════════════════════════════════════════════════════════"
  echo " WHAT YOU MUST DO NOW"
  echo "══════════════════════════════════════════════════════════════════════"
  if [ "${#TODO_NOW[@]}" -eq 0 ] && [ "${#TODO_AFTER_DNS[@]}" -eq 0 ] && [ "${#TODO_VAULT[@]}" -eq 0 ]; then
    echo " Nothing — this run left no operator actions."
  fi
  if [ "${#TODO_NOW[@]}" -gt 0 ]; then
    echo
    echo " Do now:"
    for item in "${TODO_NOW[@]}"; do
      printf '  [ ] %s\n' "$item"
    done
  fi
  if [ "${#TODO_AFTER_DNS[@]}" -gt 0 ]; then
    echo
    echo " Verify after DNS propagates:"
    for item in "${TODO_AFTER_DNS[@]}"; do
      printf '  [ ] %s\n' "$item"
    done
  fi
  if [ "${#TODO_VAULT[@]}" -gt 0 ]; then
    echo
    echo " Record in your vault:"
    for item in "${TODO_VAULT[@]}"; do
      printf '  [ ] %s\n' "$item"
    done
  fi
  echo "══════════════════════════════════════════════════════════════════════"
}

usage() {
  cat <<'USAGE'
cogeto — install, configure, upgrade, and check a Cogeto customer instance.

Usage:
  cogeto install    [--domain D] [--acme-email E] [--version X.Y.Z]
  cogeto configure  [--domain D] [--regenerate NAME] [--mail-tls-mode MODE]
  cogeto upgrade    [X.Y.Z|latest]
  cogeto status
  cogeto features   [enable <id> | disable <id>]
  cogeto reindex    [--provider LABEL --model MODEL]
  cogeto backup-info
  cogeto --help

Subcommands:
  install      First-time setup on a fresh Ubuntu 22.04/24.04 instance:
               verifies OS and resources, resolves the latest published
               release (or --version X.Y.Z) and asks for confirmation,
               installs Docker Engine + compose plugin, creates the service
               user and /srv/cogeto, fetches the pull-only deployment files
               at that version, generates per-instance secrets and the unique
               inbound email address, pulls the signed images and VERIFIES
               their signatures (cosign, mandatory), brings the stack up (TLS
               via Let's Encrypt as soon as DNS resolves), and prints the
               DNS/backup/verification checklist.
  configure    Show or change instance configuration idempotently: --domain
               moves the instance to a new domain (updates OIDC issuer, S3
               origin, inbound address); --regenerate NAME rotates a rotatable
               secret (see notes — data-bound secrets and the receipt-signing
               key are refused); --mail-tls-mode automatic|operator records who
               owns the inbound-mail certificate. 'automatic' (the default) is
               this script's own convergence: the edge obtains and renews it
               and a sidecar installs it. 'operator' means YOU supply cert.pem
               and key.pem in the mail-tls volume: nothing is ordered, nothing
               is copied, your files are never overwritten, and renewal is
               yours (docs/operations/email-inbound.md). Switching back to
               automatic takes a typed confirmation, because it hands the
               material back to the edge. Model providers are configured in the
               interface (Providers), never here.
  upgrade      Move to a published release: shows current → target (and
               whether the target is the latest published release), requires
               a typed backup acknowledgment, pulls the prebuilt images
               (never builds) and VERIFIES their signatures (cosign,
               mandatory), re-runs the migrate job, restarts app and worker,
               health-checks, and re-embeds via reindex when the recorded
               embedding model diverged. Prints the rollback procedure.
               Refuses unpublished tags and retired (pre-release) versions.
  status       Honest health report: running vs configured version, container
               health, disk and volume usage, domain and inbound address, TLS
               certificate state and renewal, last migration, queue depth and
               dead-letter count, deletion-sweep state. Green only when
               actually working.
  features     Optional capabilities (P6.7). With no verb: list the five
               capabilities this script switches (redaction, research, mail,
               demo, consoles) with their configured state, then the four the
               registry also reports and this script does NOT switch (models,
               reasoning, vision, connectors) with where each is decided; and,
               when the stack is running, the live health of all nine from
               /api/health. With the stack down the configured state is shown
               and health is stated as unknown.
               'enable <id>' / 'disable <id>' edit the instance configuration
               idempotently (COMPOSE_PROFILES + the capability's flags in
               .env), bring the affected services up or down via compose,
               wait for health, and print any operator TODOs. Disabling
               redaction requires a typed confirmation (model calls would
               send plaintext). Enabling demo is REFUSED on a production
               instance. 'enable mail'
               starts the receive-only inbound SMTP listener, opens 25/tcp in
               ufw and prints the MX/PTR steps; 'disable mail' stops it and
               closes the port again (audit 2.0 SEC-14: inbound SMTP is opt-in,
               so an instance that does not use email capture runs no
               internet-facing listener).
               Models and local model runtimes are NOT features of this
               script: they are configured in the interface (Providers and
               Models in the left rail), and so are connectors (Connections).
               Reasoning and vision are PROBED facts about the assigned
               models, not switches at all.
  reindex      Rebuild the vector index from Postgres (spec 4.2). With no
               flags: re-embed everything with the ACTIVE embeddings model —
               the repair for the mismatch the boot guard refuses (restored
               backup, direct database edit). With --provider LABEL --model
               MODEL: move the instance to a DIFFERENT embeddings model from
               the shell, using the same managed rebuild the interface runs
               (a new collection is built beside the serving one; the switch
               happens only on verified completion, so an interrupted run
               resumes and the previous configuration keeps serving). Uses
               'compose run', so it works while app and worker refuse to
               start; re-embedding the corpus costs model API calls and asks
               for a typed confirmation.
  backup-info  Exactly what to enable in the OVHcloud panel (roadmap D4 —
               the script itself performs no backups).

Global flags:
  --check      Dry run: validate prerequisites, print intended actions and the
               checklist, mutate nothing. Exercisable in CI and on any machine.
  --root DIR   Instance directory (default /srv/cogeto; env COGETO_ROOT).
  --help       This text.

Every destructive or irreversible action requires typing an explicit
confirmation phrase. Secrets are generated locally into ${COGETO_ROOT}/.env
(mode 600) and never logged. Every run ends with a "WHAT YOU MUST DO NOW"
checklist of the operator actions the script cannot perform itself.
USAGE
}

# ── Pure helpers (unit-tested via project/src/entrypoints/operator-script.spec.ts)

# Valid dotted semver X.Y.Z (no pre-release/build suffixes — releases are plain).
semver_valid() {
  printf '%s' "$1" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'
}

# version_cmp A B → prints -1 / 0 / 1 for A<B / A=B / A>B.
version_cmp() {
  a1="${1%%.*}"; rest="${1#*.}"; a2="${rest%%.*}"; a3="${rest#*.}"
  b1="${2%%.*}"; rest="${2#*.}"; b2="${rest%%.*}"; b3="${rest#*.}"
  for pair in "$a1 $b1" "$a2 $b2" "$a3 $b3"; do
    x="${pair%% *}"; y="${pair##* }"
    if [ "$x" -lt "$y" ]; then echo "-1"; return 0; fi
    if [ "$x" -gt "$y" ]; then echo "1"; return 0; fi
  done
  echo "0"
}

version_ge() { [ "$(version_cmp "$1" "$2")" != "-1" ]; }

# The per-tenant inbound address scheme: the fixed
# local part `capture` on the instance's own `in.` subdomain.
derive_inbound_address() { printf 'capture@in.%s' "$1"; }
derive_inbound_subdomain() { printf 'in.%s' "$1"; }
derive_mx_host() { printf 'mail.%s' "$1"; }
derive_s3_origin() { printf 'https://s3.%s' "$1"; }

# ── Capability helpers (P6.7) — pure, unit-tested ─────────────

FEATURE_IDS="redaction research mail demo consoles"

# The capabilities the registry reports that this script does NOT switch. They
# are listed by `features` on purpose: an operator who sees a capability in
# /api/health and not here concludes something is broken, and the honest answer
# is "it is real, it is decided somewhere else". Keep this list equal to
# CapabilityId (project/shared/src/health.ts) minus FEATURE_IDS above.
FEATURE_IDS_REPORTED_ONLY="models reasoning vision connectors"

feature_known() {
  case " ${FEATURE_IDS} " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

feature_reported_only() {
  case " ${FEATURE_IDS_REPORTED_ONLY} " in *" $1 "*) return 0 ;; *) return 1 ;; esac
}

# Where a registry-reported, non-switchable capability is actually decided.
feature_decided_by() {
  case "$1" in
    models)     echo "interface: Providers, then Models (never .env, never here)" ;;
    reasoning)  echo "probed: whether the assigned answer model returns a thinking field" ;;
    vision)     echo "interface: assign a vision model under Models (unassigned is a complete answer)" ;;
    connectors) echo "interface: Connections (off until one is added)" ;;
    *)          echo "" ;;
  esac
}

# The compose profile a capability rides on.
feature_profile() {
  case "$1" in
    redaction) echo "redaction" ;;
    research)  echo "research" ;;
    mail)      echo "mail" ;;
    demo)      echo "demo" ;;
    consoles)  echo "consoles" ;;
    *)         echo "" ;;
  esac
}

# COMPOSE_PROFILES list editing: comma-separated, normalized (no blanks, no
# duplicates), idempotent — enable twice or disable twice is a no-op.
profiles_has() {  # profiles_has LIST ID
  case ",$(printf '%s' "$1" | tr -d ' ')," in *",$2,"*) return 0 ;; *) return 1 ;; esac
}

profiles_add() {  # profiles_add LIST ID → normalized list including ID
  if profiles_has "$1" "$2"; then
    printf '%s' "$(printf '%s' "$1" | tr -d ' ')"
  elif [ -z "$(printf '%s' "$1" | tr -d ' ,')" ]; then
    printf '%s' "$2"
  else
    printf '%s,%s' "$(printf '%s' "$1" | tr -d ' ')" "$2"
  fi
}

profiles_remove() {  # profiles_remove LIST ID → normalized list without ID
  printf '%s' "$1" | tr -d ' ' | tr ',' '\n' | grep -vx "$2" | grep -v '^$' | paste -sd, - || true
}

# Minimal domain sanity: at least one dot, valid label characters, no scheme.
domain_valid() {
  printf '%s' "$1" | grep -Eq '^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$'
}

# Secret generators — values go straight into .env; NEVER echo them.
gen_password() {  # 32 chars, alphanumeric (safe in URLs, env files, psql)
  openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 32
}
gen_token() {     # 64 hex chars
  openssl rand -hex 32
}
gen_zitadel_masterkey() {  # Zitadel requires EXACTLY 32 characters
  openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 32
}
gen_zitadel_admin_password() {
  # Zitadel's default policy wants upper + lower + digit + symbol; the random
  # tail keeps the entropy, the fixed 4-char prefix guarantees the classes.
  printf 'Cg1!%s' "$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 20)"
}
gen_minio_kms_key() {  # <key-name>:<base64 of 32 random bytes>
  printf 'cogeto-instance-key:%s' "$(openssl rand -base64 32)"
}
gen_master_key() {  # V2.4 item 7.1: 32 random bytes, base64 — encrypts provider keys
  openssl rand -base64 32
}
gen_bootstrap_pat_expiry() {  # SEC-16: install date + 14 days (bootstrap backstop)
  # GNU date (Ubuntu target); BSD date fallback for a dev-box dry run.
  date -u -d '+14 days' '+%Y-%m-%dT00:00:00Z' 2>/dev/null \
    || date -u -v +14d '+%Y-%m-%dT00:00:00Z'
}

# Wave-3 credentials (SEC-1/SEC-2/SEC-16) on an instance installed before
# they existed: the fetched compose REQUIRES them (`:?`), so an upgrade must
# backfill any that are missing. Generation is idempotent — an existing value
# is never touched. db-init/minio-init then converge the actual roles and the
# scoped MinIO user from these values on the next `compose up`.
ensure_wave3_secrets() {
  [ -n "$(env_get COGETO_APP_DB_PASSWORD)" ]     || env_set COGETO_APP_DB_PASSWORD "$(gen_password)"
  [ -n "$(env_get COGETO_MIGRATE_DB_PASSWORD)" ] || env_set COGETO_MIGRATE_DB_PASSWORD "$(gen_password)"
  [ -n "$(env_get ZITADEL_DB_ADMIN_PASSWORD)" ]  || env_set ZITADEL_DB_ADMIN_PASSWORD "$(gen_password)"
  [ -n "$(env_get COGETO_S3_ACCESS_KEY)" ]       || env_set COGETO_S3_ACCESS_KEY "cogeto-app"
  [ -n "$(env_get COGETO_S3_SECRET_KEY)" ]       || env_set COGETO_S3_SECRET_KEY "$(gen_password)"
  [ -n "$(env_get ZITADEL_BOOTSTRAP_PAT_EXPIRY)" ] || env_set ZITADEL_BOOTSTRAP_PAT_EXPIRY "$(gen_bootstrap_pat_expiry)"
  # The instance master key: encrypts the provider API keys entered in the
  # interface. Backfilled when missing (an instance installed before it
  # existed), NEVER regenerated when set — rotating it would make every
  # stored provider key unreadable.
  [ -n "$(env_get COGETO_MASTER_KEY)" ]          || env_set COGETO_MASTER_KEY "$(gen_master_key)"
}

# SEC-14 upgrade continuity. Inbound mail moved behind the `mail` compose
# profile, which is OFF by default. An instance that was ALREADY receiving
# email must not silently lose it on upgrade, so: if the mail container exists
# on this host (running or stopped) and the profile is not yet configured, the
# capability is carried forward and said out loud. A fresh install, which has
# no mail container, gets the new secure default.
carry_forward_mail_capability() {
  mail_capability_enabled && return 0
  if [ "$CHECK" -eq 1 ]; then
    say "[dry-run] would carry an existing inbound-mail deployment forward onto the new 'mail' profile"
    return 0
  fi
  if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -q '^cogeto-mail-'; then
    env_set COMPOSE_PROFILES "$(profiles_add "$(env_get COMPOSE_PROFILES)" mail)"
    env_set COGETO_MAIL_ENABLED "1"
    say "this instance was already receiving email: inbound mail is now an opt-in capability (audit 2.0 SEC-14) and has been carried forward as ENABLED — nothing changes for the customer. Turn it off any time with 'cogeto features disable mail'."
  else
    say "inbound mail is now an opt-in capability (audit 2.0 SEC-14) and this instance was not running it — it stays OFF, and no SMTP listener is started. Enable it with 'cogeto features enable mail'."
  fi
}

# ── .env helpers ──────────────────────────────────────────────────────────────

ENV_FILE=""  # set in main() from COGETO_ROOT

env_get() {  # env_get KEY → value or empty
  [ -f "$ENV_FILE" ] || return 0
  sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1
}

env_set() {  # env_set KEY VALUE — idempotent replace-or-append; value never logged
  key="$1"; value="$2"
  if [ "$CHECK" -eq 1 ]; then
    say "[dry-run] would set ${key} in ${ENV_FILE}"
    return 0
  fi
  touch "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  if grep -q "^${key}=" "$ENV_FILE"; then
    # sed -i differs between GNU/BSD; a temp file is portable. `|| true`: when
    # the replaced key is the ONLY line, grep -v matches nothing and exits 1,
    # which set -e would otherwise turn into a silent abort.
    grep -v "^${key}=" "$ENV_FILE" > "${ENV_FILE}.tmp" || true
    printf '%s=%s\n' "$key" "$value" >> "${ENV_FILE}.tmp"
    chmod 600 "${ENV_FILE}.tmp"
    mv "${ENV_FILE}.tmp" "$ENV_FILE"
  else
    printf '%s=%s\n' "$key" "$value" >> "$ENV_FILE"
  fi
}

# ── Host checks ───────────────────────────────────────────────────────────────

check_os() {
  if [ ! -f /etc/os-release ]; then
    [ "$CHECK" -eq 1 ] && { warn "no /etc/os-release — cannot verify Ubuntu (check mode continues)"; return 0; }
    die "unsupported OS: /etc/os-release not found (supported: Ubuntu ${SUPPORTED_UBUNTU})"
  fi
  os_id="$(sed -n 's/^ID=//p' /etc/os-release | tr -d '"')"
  os_ver="$(sed -n 's/^VERSION_ID=//p' /etc/os-release | tr -d '"')"
  ok=1
  [ "$os_id" = "ubuntu" ] || ok=0
  case " ${SUPPORTED_UBUNTU} " in *" ${os_ver} "*) : ;; *) ok=0 ;; esac
  if [ "$ok" -eq 1 ]; then
    say "OS check: ${os_id} ${os_ver} — supported"
  else
    [ "$CHECK" -eq 1 ] && { warn "OS is ${os_id:-unknown} ${os_ver:-unknown}; supported: Ubuntu ${SUPPORTED_UBUNTU} (check mode continues)"; return 0; }
    die "unsupported OS ${os_id:-unknown} ${os_ver:-unknown} — supported: Ubuntu ${SUPPORTED_UBUNTU}"
  fi
}

check_resources() {
  ram_mb=0; cpus=0; disk_gb=0
  if [ -r /proc/meminfo ]; then
    ram_kb="$(sed -n 's/^MemTotal:[[:space:]]*\([0-9]*\).*/\1/p' /proc/meminfo)"
    ram_mb=$((ram_kb / 1024))
  fi
  cpus="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 0)"
  docker_fs="/var/lib/docker"; [ -d "$docker_fs" ] || docker_fs="/"
  disk_gb="$(df -Pk "$docker_fs" 2>/dev/null | awk 'NR==2 {printf "%d", $4/1024/1024}')"
  say "resources: ${ram_mb} MB RAM, ${cpus} CPUs, ${disk_gb} GB free on ${docker_fs}"
  problems=""
  [ "$ram_mb" -ge "$MIN_RAM_MB" ] || problems="${problems} RAM<${MIN_RAM_MB}MB"
  [ "$cpus" -ge "$MIN_CPUS" ] || problems="${problems} CPUs<${MIN_CPUS}"
  [ "$disk_gb" -ge "$MIN_DISK_GB" ] || problems="${problems} disk<${MIN_DISK_GB}GB"
  if [ -n "$problems" ]; then
    if [ "$CHECK" -eq 1 ] || [ "${COGETO_SKIP_RESOURCE_CHECK:-0}" = "1" ]; then
      warn "resource check failed:${problems} — the stack (Postgres, Qdrant, MinIO, Zitadel, app, worker, mail, edge) needs at least ${MIN_RAM_MB}MB RAM / ${MIN_CPUS} CPUs / ${MIN_DISK_GB}GB free"
    else
      die "insufficient resources:${problems}. This stack needs ≥${MIN_RAM_MB}MB RAM, ≥${MIN_CPUS} CPUs, ≥${MIN_DISK_GB}GB free (set COGETO_SKIP_RESOURCE_CHECK=1 to override at your own risk)"
    fi
  fi
}

require_root() {
  [ "$CHECK" -eq 1 ] && return 0
  [ "$(id -u)" -eq 0 ] || die "this subcommand must run as root (sudo)"
}

detect_public_ip() {
  ip=""
  ip="$(curl -fsS --max-time 5 https://api.ipify.org 2>/dev/null || true)"
  if [ -z "$ip" ]; then
    ip="$(hostname -I 2>/dev/null | awk '{print $1}' || true)"
  fi
  printf '%s' "${ip:-<the instance public IPv4>}"
}

compose() {
  docker compose --project-directory "$COGETO_ROOT" "$@"
}

# ── Release lookups (Docker Hub) ──────────────────────────────────────────────

hub_tag_exists() {
  curl -fsS --max-time 15 "${HUB_API}/${IMAGE}/tags/$1" >/dev/null 2>&1
}

hub_latest_version() {
  # Highest published semver tag of cogeto/cogeto. No jq dependency: extract
  # the tag names, keep plain X.Y.Z, sort -V.
  curl -fsS --max-time 15 "${HUB_API}/${IMAGE}/tags?page_size=100" 2>/dev/null \
    | tr ',' '\n' \
    | sed -n 's/.*"name":[[:space:]]*"\([0-9][0-9.]*\)".*/\1/p' \
    | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' \
    | sort -V \
    | tail -n 1
}

github_latest_version() {
  # The newest release NOT flagged pre-release or draft — GitHub's /latest
  # endpoint applies that filter itself. No jq: extract
  # tag_name, strip the leading v.
  curl -fsS --max-time 15 "${GH_RELEASES_API}/latest" 2>/dev/null \
    | sed -n 's/.*"tag_name":[[:space:]]*"v\{0,1\}\([0-9][0-9.]*\)".*/\1/p' \
    | head -n 1
}

resolve_latest_version() {
  # GitHub releases are the version-policy authority; Docker Hub tags are the
  # fallback when the API is unreachable (tags cannot express retirement, so
  # the fallback is only for network trouble, not policy).
  rlv_v="$(github_latest_version)"
  if [ -z "$rlv_v" ]; then
    warn "could not reach the GitHub releases API — falling back to Docker Hub tags"
    rlv_v="$(hub_latest_version)"
  fi
  printf '%s' "$rlv_v"
}

require_supported_version() {
  # An explicitly requested version must be a published, non-retired release.
  # Retired/testing releases carry the GitHub pre-release flag.
  rsv_v="$1"
  rsv_body="$(curl -fsS --max-time 15 "${GH_RELEASES_API}/tags/v${rsv_v}" 2>/dev/null)" || rsv_body=""
  if [ -z "$rsv_body" ]; then
    if [ "$CHECK" -eq 1 ]; then
      warn "could not confirm v${rsv_v} against the GitHub releases API (offline check run?)"
      return 0
    fi
    die "v${rsv_v} is not a published release (or the GitHub API is unreachable) — run without an explicit version to get the latest, or see https://github.com/${GITHUB_REPO}/releases"
  fi
  if printf '%s' "$rsv_body" | grep -q '"prerelease":[[:space:]]*true'; then
    die "v${rsv_v} is a retired/testing release and will not be installed — the latest supported release is v$(resolve_latest_version)"
  fi
  say "release v${rsv_v} is published and supported"
}

# Which Cogeto image tags on this host are safe to delete, given the two
# versions worth keeping. Pure and unit-tested: reads "repo:tag" lines on stdin
# and prints the ones to remove.
#
# The rule, and why it is this one:
#
#   • ONLY cogeto/cogeto[-edge|-mail|-redaction]. The infra images (postgres,
#     qdrant, minio, zitadel, searxng) are digest-pinned upstream images shared
#     with nothing else on this box; deleting them buys a few hundred megabytes
#     and costs a re-pull of things that are not ours, against a Docker Hub
#     rate limit. Never worth it.
#   • KEEP THE PREVIOUS VERSION, not just the current one. `cogeto upgrade
#     <older>` is the documented rollback, and it is only instant, and only
#     possible at all with a dead or rate-limiting registry, while the previous
#     images are still on disk. One release back is the whole point; two is
#     hoarding, since a release is ~1 GB across the four images.
#   • Anything else Cogeto-published goes, including `latest` (this instance
#     always runs an explicit version, so a floating tag here is a leftover).
prunable_image_tags() {  # prunable_image_tags KEEP_CURRENT KEEP_PREVIOUS  < refs
  pit_keep_a="$1"; pit_keep_b="$2"
  while IFS= read -r pit_ref; do
    [ -n "$pit_ref" ] || continue
    case "$pit_ref" in
      cogeto/cogeto:* | cogeto/cogeto-edge:* | cogeto/cogeto-mail:* | cogeto/cogeto-redaction:*) : ;;
      *) continue ;;
    esac
    pit_tag="${pit_ref##*:}"
    if [ "$pit_tag" = "$pit_keep_a" ] || [ "$pit_tag" = "$pit_keep_b" ]; then
      continue
    fi
    printf '%s\n' "$pit_ref"
  done
}

# Delete them. Deliberately NOT forced: `docker rmi` refuses an image any
# container still references, running or stopped, and that refusal is a feature
# here — the one thing this must never do is pull the floor out from under a
# container. A refusal is reported, not worked around, and never fails the run:
# an upgrade that succeeded must not end in an error because a cleanup could
# not delete something.
prune_old_images() {  # prune_old_images KEEP_CURRENT KEEP_PREVIOUS
  command -v docker >/dev/null 2>&1 || return 0
  poi_refs="$(docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null \
    | prunable_image_tags "$1" "$2" | sort -u)"
  if [ -z "$poi_refs" ]; then
    say "image cleanup: nothing to remove (keeping v${1} and v${2})"
    return 0
  fi
  say "image cleanup: keeping v${1} (current) and v${2} (rollback target); removing $(printf '%s\n' "$poi_refs" | wc -l | tr -d ' ') older Cogeto image(s). Infra images are digest-pinned and are never touched."
  for poi_ref in $poi_refs; do
    # The dry run must say "would", not "removed": `run` swallows its own
    # announcement here because the rmi output is discarded, so the report is
    # written explicitly rather than inferred from an exit code that is 0 in
    # check mode by construction.
    if [ "$CHECK" -eq 1 ]; then
      say "  [dry-run] would remove ${poi_ref}"
    elif docker rmi "$poi_ref" >/dev/null 2>&1; then
      say "  removed ${poi_ref}"
    else
      say "  kept ${poi_ref} (still referenced by a container)"
    fi
  done
  [ "$CHECK" -eq 1 ] || say "disk now: $(docker system df --format '{{.Type}} {{.Size}}' 2>/dev/null | tr '\n' ' ' || echo 'see docker system df')"
}

# The images THIS instance runs: the three always-present ones, plus the
# redaction sidecar when the capability is on. One list, so pull, verify and
# the printed verify commands can never disagree about what is installed.
instance_images() {
  printf '%s %s %s' "$IMAGE" "$IMAGE_EDGE" "$IMAGE_MAIL"
  [ "$(feature_configured redaction)" = "enabled" ] && printf ' %s' "$IMAGE_REDACTION"
  printf '\n'
}

print_cosign_commands() {
  version="$1"
  say "verify the pulled images (keyless cosign; run any time):"
  for img in $(instance_images); do
    cat <<EOF
  cosign verify ${img}:${version} \\
    --certificate-identity-regexp '^https://github.com/${GITHUB_REPO}/\\.github/workflows/release\\.yml@refs/tags/' \\
    --certificate-oidc-issuer 'https://token.actions.githubusercontent.com'
EOF
  done
}

# sha256 of a file, portable across the Ubuntu target (sha256sum) and the
# macOS box the operator-script spec runs on (shasum).
sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | cut -d' ' -f1
  else
    die "neither sha256sum nor shasum is available — cannot verify downloads, refusing to continue"
  fi
}

# Install cosign from its pinned GitHub release (idempotent; single static
# binary). Failure is FATAL: images are only ever started
# after their signatures verify, so a missing verifier stops the run.
#
# SEC-13: the binary is VERIFIED against the pinned sha256 BEFORE it is made
# executable or moved onto PATH. Previously it was curl → chmod 0755 → root's
# PATH with no check at all, which meant the entire image-provenance chain
# terminated in an unverified binary downloaded as root: substituting cosign
# (a compromised release asset, a CDN compromise, corporate TLS interception)
# yielded root RCE *and* silently green signature verification afterwards.
install_cosign() {
  if command -v cosign >/dev/null 2>&1; then
    say "cosign already installed — skipping"
    return 0
  fi
  url="https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-amd64"
  say "installing cosign v${COSIGN_VERSION} (image-signature verification)"
  if [ "$CHECK" -eq 1 ]; then
    say "[dry-run] would install cosign: ${url} → /usr/local/bin/cosign"
    say "[dry-run] would verify its sha256 against the checksum pinned in this script (COSIGN_SHA256) before making it executable"
    return 0
  fi
  if ! curl -fsSL --max-time 120 "$url" -o /usr/local/bin/cosign.tmp; then
    rm -f /usr/local/bin/cosign.tmp
    die "could not download cosign from ${url} — image signatures cannot be verified, refusing to continue. Check the network and re-run."
  fi
  # Not executable yet, and not on PATH yet: verify first.
  actual="$(sha256_of /usr/local/bin/cosign.tmp)"
  if [ "$actual" != "$COSIGN_SHA256" ]; then
    rm -f /usr/local/bin/cosign.tmp
    die "COSIGN CHECKSUM MISMATCH — refusing to install. Expected ${COSIGN_SHA256}, got ${actual}. The download from ${url} is not the release this script was written against. Do NOT work around this: it is exactly the substitution the check exists to catch. Verify the network path and re-run; if the mismatch persists, stop and contact the vendor."
  fi
  say "cosign download verified against the pinned sha256"
  chmod 0755 /usr/local/bin/cosign.tmp
  mv /usr/local/bin/cosign.tmp /usr/local/bin/cosign
  say "cosign installed: $(cosign version 2>/dev/null | head -n 1 || echo v${COSIGN_VERSION})"
}

# Put this script on PATH so the printed 'sudo cogeto status' just works
# (o6-dry-run: the operator ran ./cogeto from \$HOME and 'cogeto' was not found).
install_self() {
  # Unique variable names: bash function variables are global, and callers
  # (cmd_upgrade) hold state in `target` — a collision here broke upgrades.
  self_install_target="/usr/local/bin/cogeto"
  self_install_source="$0"
  if [ "$self_install_source" = "$self_install_target" ]; then
    return 0
  fi
  say "installing this script to ${self_install_target} (so 'sudo cogeto status' works from anywhere)"
  run install -m 0755 "$self_install_source" "$self_install_target"
}

verify_images() {
  version="$1"
  vi_images="$(instance_images)"
  vi_count="$(printf '%s' "$vi_images" | wc -w | tr -d ' ')"
  if command -v cosign >/dev/null 2>&1; then
    say "cosign found — verifying image signatures"
    for img in $vi_images; do
      # Named, not silent: a bare `set -e` abort here reads to an operator as
      # "the pull failed", which sends them to the network instead of to the
      # signature. Keyless verification also reaches Sigstore over the network,
      # so a transient failure is not the same thing as a bad signature and the
      # message must not pretend to know which it was.
      if ! run cosign verify "${img}:${version}" \
        --certificate-identity-regexp "^https://github.com/${GITHUB_REPO}/\\.github/workflows/release\\.yml@refs/tags/" \
        --certificate-oidc-issuer 'https://token.actions.githubusercontent.com' >/dev/null; then
        die "SIGNATURE VERIFICATION FAILED for ${img}:${version} — refusing to start it, and nothing was changed. Either that image is not signed by this project's release workflow (do NOT work around this: it is exactly what the check exists to catch), or cosign could not reach Sigstore's transparency log. Re-run the command above by hand to see which: cosign verify ${img}:${version} --certificate-identity-regexp '^https://github.com/${GITHUB_REPO}/\\.github/workflows/release\\.yml@refs/tags/' --certificate-oidc-issuer 'https://token.actions.githubusercontent.com'"
      fi
    done
    [ "$CHECK" -eq 1 ] || say "all ${vi_count} image signatures verified"
  elif [ "$CHECK" -eq 1 ]; then
    say "[dry-run] would verify all ${vi_count} image signatures with cosign"
  else
    die "cosign is not installed — refusing to start unverified images. Re-run: install/upgrade installs cosign automatically."
  fi
  print_cosign_commands "$version"
}

# ── Deployment assets ─────────────────────────────────────────────────────────
#
# The files that define the entire customer stack — the compose file, the
# production Caddyfile, the Zitadel bootstrap script, the Postgres role
# provisioning, the SearXNG settings — arrive as ONE checksummed release
# artifact, `cogeto-deploy-assets-X.Y.Z.tar.gz`, attached to that version's
# GitHub Release. They used to be fetched file by file from the repository at
# the tag's commit; one artifact per release replaces that, for two reasons:
#
#   • ONE thing to verify. The release publishes the tarball's sha256 as its
#     own asset, so it can be read (and compared against the release page)
#     without downloading the thing it verifies. The per-file manifest
#     (`deploy-assets.sha256`) travels INSIDE the tarball, so every consumer —
#     this installer and the hosting platform's upgrade automation — verifies
#     the same way: one outer checksum for the release, per-file hashes within.
#   • ONE version relationship. The download URL names the tag and nothing
#     else, and the tarball carries a VERSION file that must agree with the
#     version being installed. Neither end is a moving reference, and a
#     disagreement is a hard failure below, never a silent install of the
#     wrong release's stack definition.
#
# The four ways this can fail are four different problems and say so:
# ARTIFACT MISSING (that release does not carry one — stop), RELEASE
# UNREACHABLE (network — retrying is safe), OUTER CHECKSUM MISMATCH (the bytes
# are not the ones published — stop), and DEPLOYMENT FILE CHECKSUM MISMATCH
# (the tarball disagrees with its own manifest — stop).

# Release assets are served under the tag that names them.
GH_RELEASE_DOWNLOAD="https://github.com/${GITHUB_REPO}/releases/download"

# The per-file manifest, at its repository path INSIDE the artifact.
DEPLOY_MANIFEST_PATH="project/infra/deploy/deploy-assets.sha256"
DEPLOY_MANIFEST_FILE=""   # set per run by stage_deploy_artifact
DEPLOY_STAGE_DIR=""       # the temporary download directory, removed after use
DEPLOY_UNPACKED=""        # the verified staging tree, set per run

deploy_artifact_name() { printf 'cogeto-deploy-assets-%s.tar.gz' "$1"; }

# Download one asset of the vX.Y.Z release. The exit code separates the two
# failures an operator acts on differently:
#   0  downloaded
#   2  the asset is not on that release (HTTP 404) — retrying cannot help
#   3  the release could not be reached at all — retrying is the right move
download_release_asset() {
  dra_version="$1"; dra_name="$2"; dra_dest="$3"
  dra_url="${GH_RELEASE_DOWNLOAD}/v${dra_version}/${dra_name}"
  # curl's own exit status comes first: a connection that dropped mid-body
  # still reports 200, and a truncated download is a network problem to retry,
  # not a checksum failure to stop on. curl keeps its stderr so the operator
  # reads its diagnosis alongside ours.
  if dra_code="$(curl -sSL --max-time 180 -w '%{http_code}' -o "$dra_dest" "$dra_url")"; then
    dra_rc=0
  else
    dra_rc=$?
  fi
  if [ "$dra_rc" -ne 0 ]; then rm -f "$dra_dest"; return 3; fi
  case "$dra_code" in
    200) return 0 ;;
    404) rm -f "$dra_dest"; return 2 ;;
    *)   rm -f "$dra_dest"; return 3 ;;
  esac
}

# Download, verify and unpack one version's deployment artifact into a staging
# tree. Nothing is installed here: callers pick what they need with
# install_asset and call release_deploy_artifact when they are done.
stage_deploy_artifact() {
  version="$1"
  artifact="$(deploy_artifact_name "$version")"

  if [ "$CHECK" -eq 1 ]; then
    say "[dry-run] would fetch ${GH_RELEASE_DOWNLOAD}/v${version}/${artifact} and ${artifact}.sha256, verify the tarball against that published checksum, and verify every file inside it against ${DEPLOY_MANIFEST_PATH} before installing it"
  fi

  DEPLOY_MANIFEST_FILE=""
  DEPLOY_UNPACKED=""
  if [ "$CHECK" -eq 0 ]; then
    DEPLOY_STAGE_DIR="$(mktemp -d)"
    stage="$DEPLOY_STAGE_DIR"
    DEPLOY_UNPACKED="${stage}/unpacked"
    mkdir -p "$DEPLOY_UNPACKED"

    # 1. The outer checksum FIRST, as its own release asset. A checksum shipped
    #    only inside the thing it verifies proves nothing.
    if download_release_asset "$version" "${artifact}.sha256" "${stage}/checksum"; then :; else
      case $? in
        2) die "DEPLOY ASSETS: ARTIFACT MISSING FROM THE RELEASE — the v${version} release publishes no ${artifact}.sha256. Every release that carries the deployment artifact publishes its checksum beside it, so this is either a release published before the artifact existed (install it with the operator script from its own tag, or choose a newer version) or a release whose publication did not finish. STOP: nothing was changed, and retrying cannot make a missing asset appear. See https://github.com/${GITHUB_REPO}/releases/tag/v${version}" ;;
        *) die "DEPLOY ASSETS: RELEASE UNREACHABLE — could not reach ${GH_RELEASE_DOWNLOAD}/v${version}/${artifact}.sha256. This is a network, DNS, proxy or GitHub-availability problem, not a verification failure: nothing was changed and RETRYING IS SAFE. Check this host's outbound access to github.com, then re-run the same command." ;;
      esac
    fi
    expected_outer="$(awk 'NR == 1 { print $1 }' "${stage}/checksum")"
    named_artifact="$(awk 'NR == 1 { print $2 }' "${stage}/checksum")"
    if ! printf '%s' "$expected_outer" | grep -qE '^[0-9a-f]{64}$'; then
      die "DEPLOY ASSETS: MALFORMED ARTIFACT — ${artifact}.sha256 on the v${version} release does not carry a sha256 checksum. STOP: that release cannot be verified and must not be installed. Report it; do not work around it."
    fi
    if [ "$named_artifact" != "$artifact" ]; then
      die "DEPLOY ASSETS: MALFORMED ARTIFACT — ${artifact}.sha256 names '${named_artifact}', not ${artifact}. The published checksum belongs to a different file, so it cannot verify this one. STOP; do not work around it."
    fi

    # 2. The artifact itself, verified against that checksum before it is opened.
    if download_release_asset "$version" "$artifact" "${stage}/${artifact}"; then :; else
      case $? in
        2) die "DEPLOY ASSETS: ARTIFACT MISSING FROM THE RELEASE — the v${version} release publishes a checksum but no ${artifact}. STOP: the release is incomplete, nothing was changed, and retrying cannot make a missing asset appear. Report it at https://github.com/${GITHUB_REPO}/releases/tag/v${version}" ;;
        *) die "DEPLOY ASSETS: RELEASE UNREACHABLE — could not download ${GH_RELEASE_DOWNLOAD}/v${version}/${artifact}. This is a network, DNS, proxy or GitHub-availability problem, not a verification failure: nothing was changed and RETRYING IS SAFE. Check this host's outbound access to github.com, then re-run the same command." ;;
      esac
    fi
    actual_outer="$(sha256_of "${stage}/${artifact}")"
    if [ "$actual_outer" != "$expected_outer" ]; then
      die "DEPLOY ASSETS: OUTER CHECKSUM MISMATCH for ${artifact} — the v${version} release publishes ${expected_outer}, the downloaded file hashes to ${actual_outer}. STOP. Nothing was changed and nothing was unpacked. Either the download was corrupted in transit or these are not the bytes this release published; do NOT work around it, which is exactly what the check exists to catch. Compare ${expected_outer} against the checksum shown on https://github.com/${GITHUB_REPO}/releases/tag/v${version} before doing anything else."
    fi
    say "deployment artifact ${artifact} verified against the release checksum (${actual_outer})"

    # 3. Unpack. Entry names are checked before extraction: an artifact naming
    #    an absolute or escaping path is malformed, not something to sanitise.
    entries="$(tar -tzf "${stage}/${artifact}" 2>/dev/null)" || entries=""
    if [ -z "$entries" ]; then
      die "DEPLOY ASSETS: MALFORMED ARTIFACT — ${artifact} could not be read as a gzipped tar even though its checksum matched. STOP: this release's artifact is broken and must not be installed. Report it; do not work around it."
    fi
    if printf '%s\n' "$entries" | grep -qE '^/|(^|/)\.\.(/|$)'; then
      die "DEPLOY ASSETS: MALFORMED ARTIFACT — ${artifact} contains an absolute or escaping path. STOP: nothing was extracted. Report it; do not work around it."
    fi
    tar -xzf "${stage}/${artifact}" -C "$DEPLOY_UNPACKED" \
      || die "DEPLOY ASSETS: MALFORMED ARTIFACT — ${artifact} could not be unpacked. STOP: this release's artifact is broken and must not be installed."

    # 4. The artifact must be the one this version asked for. The URL says the
    #    tag and the tarball says the version; both, or the install stops.
    stamped="$(tr -d '[:space:]' < "${DEPLOY_UNPACKED}/VERSION" 2>/dev/null || true)"
    if [ "$stamped" != "$version" ]; then
      die "DEPLOY ASSETS: VERSION MISMATCH — the artifact published for v${version} is stamped '${stamped:-(no VERSION file)}'. STOP: nothing was installed. The release's deployment files do not belong to the version being installed, and installing them would give this instance another release's stack definition. Report it; do not work around it."
    fi

    # 5. The per-file manifest that travelled inside it. Everything below is
    #    verified against this before it is installed.
    DEPLOY_MANIFEST_FILE="${DEPLOY_UNPACKED}/${DEPLOY_MANIFEST_PATH}"
    if [ ! -f "$DEPLOY_MANIFEST_FILE" ]; then
      DEPLOY_MANIFEST_FILE=""
      die "DEPLOY ASSETS: MALFORMED ARTIFACT — ${artifact} carries no ${DEPLOY_MANIFEST_PATH}, so nothing inside it can be checked: refusing to install unverified deployment files. STOP; do not work around it."
    fi
    # 6. Verify EVERY file the manifest covers before installing any of them.
    #    Per-file verification also happens at install time, but doing the whole
    #    set first is what makes a rejected artifact leave nothing behind: an
    #    upgrade that aborted halfway through would otherwise leave the instance
    #    with a compose file from one release and a Caddyfile from another.
    while read -r want file; do
      [ -n "${file:-}" ] || continue
      src="${DEPLOY_UNPACKED}/${file}"
      if [ ! -f "$src" ] || [ -L "$src" ]; then
        die "DEPLOY ASSETS: MALFORMED ARTIFACT — ${DEPLOY_MANIFEST_PATH} inside ${artifact} covers ${file}, which the artifact does not contain as a regular file. STOP: nothing was installed. Report it; do not work around it."
      fi
      got="$(sha256_of "$src")"
      if [ "$got" != "$want" ]; then
        die "DEPLOYMENT FILE CHECKSUM MISMATCH for ${file} — expected ${want}, got ${got}. Refusing to install, and NOTHING has been changed on this instance. The file inside the deployment artifact is not the one this release's manifest describes: the artifact's contents and its own checksum list disagree, which nothing legitimate does. STOP; do not work around it."
      fi
    done < "$DEPLOY_MANIFEST_FILE"
    say "v${version} deployment assets unpacked and verified ($(wc -l < "$DEPLOY_MANIFEST_FILE" | tr -d ' ') files, each against the manifest inside the artifact)"
  fi
}

# The staging tree exists only for the duration of one fetch.
release_deploy_artifact() {
  [ -n "$DEPLOY_STAGE_DIR" ] && rm -rf "$DEPLOY_STAGE_DIR"
  DEPLOY_STAGE_DIR=""
  DEPLOY_MANIFEST_FILE=""
  DEPLOY_UNPACKED=""
  return 0
}

# The whole deployment set for one version: what install and upgrade both run.
fetch_deploy_assets() {
  stage_deploy_artifact "$1"
  run mkdir -p "$COGETO_ROOT/zitadel-init"
  install_asset "project/infra/deploy/docker-compose.deploy.yml" "$COGETO_ROOT/docker-compose.yml"
  install_asset "project/infra/deploy/Caddyfile" "$COGETO_ROOT/Caddyfile"
  install_asset "project/infra/docker/zitadel-init/init.mjs" "$COGETO_ROOT/zitadel-init/init.mjs"
  # Least-privilege Postgres roles (SEC-1): the db-init one-shot mounts this.
  run mkdir -p "$COGETO_ROOT/postgres-init"
  install_asset "project/infra/docker/postgres-init/db-init.sql" "$COGETO_ROOT/postgres-init/db-init.sql"
  # The research profile's SearXNG settings — installed with the
  # other assets so `cogeto features enable research` works offline later.
  run mkdir -p "$COGETO_ROOT/searxng"
  install_asset "project/infra/docker/searxng/settings.yml" "$COGETO_ROOT/searxng/settings.yml"
  release_deploy_artifact
}

# The expected sha256 for one repo path, read from the manifest inside the
# artifact.
manifest_sha() {
  [ -n "$DEPLOY_MANIFEST_FILE" ] || return 0
  awk -v p="$1" '$2 == p { print $1 }' "$DEPLOY_MANIFEST_FILE" | head -n 1
}

# Verify one unpacked deployment file against the artifact's own manifest and
# put it in place. Verification happens BEFORE the file is installed, and a
# missing manifest entry is a failure, not a skip: silently accepting an
# uncovered file would make the manifest decorative.
install_asset() {
  path="$1"; dest="$2"
  if [ "$CHECK" -eq 1 ]; then
    say "[dry-run] would install ${path} → ${dest} after verifying its sha256 against ${DEPLOY_MANIFEST_PATH}"
    return 0
  fi
  src="${DEPLOY_UNPACKED}/${path}"
  if [ ! -f "$src" ] || [ -L "$src" ]; then
    die "DEPLOY ASSETS: MALFORMED ARTIFACT — ${path} is not in $(deploy_artifact_name "$version") as a regular file, so this release cannot install a complete stack. STOP; do not work around it."
  fi
  expected="$(manifest_sha "$path")"
  if [ -z "$expected" ]; then
    die "no checksum for ${path} in ${DEPLOY_MANIFEST_PATH} — refusing to install an unverified deployment file. This release's manifest is incomplete; do not work around it."
  fi
  actual="$(sha256_of "$src")"
  if [ "$actual" != "$expected" ]; then
    die "DEPLOYMENT FILE CHECKSUM MISMATCH for ${path} — expected ${expected}, got ${actual}. Refusing to install. The file inside the deployment artifact is not the one this release's manifest describes: the artifact's contents and its own checksum list disagree, which nothing legitimate does. STOP; do not work around it."
  fi
  cp "$src" "$dest"
  chmod 0644 "$dest"
  say "installed + verified ${path} → ${dest}"
}

# ── Docker installation (idempotent) ─────────────────────────────────────────

install_docker() {
  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    say "Docker Engine + compose plugin already installed — skipping"
    return 0
  fi
  say "installing Docker Engine + compose plugin from download.docker.com (official apt repo)"
  if [ "$CHECK" -eq 1 ]; then
    say "[dry-run] would: apt-get install ca-certificates curl; add Docker's GPG key + apt repo; apt-get install docker-ce docker-ce-cli containerd.io docker-compose-plugin"
    return 0
  fi
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc
  # shellcheck disable=SC1091
  codename="$(. /etc/os-release && echo "$VERSION_CODENAME")"
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu ${codename} stable" \
    > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-compose-plugin
  systemctl enable --now docker
  say "Docker installed: $(docker --version)"
}

ensure_service_user() {
  if id "$SERVICE_USER" >/dev/null 2>&1; then
    say "service user '${SERVICE_USER}' already exists — skipping"
  else
    say "creating system user '${SERVICE_USER}' (no login shell)"
    run useradd --system --home-dir "$COGETO_ROOT" --shell /usr/sbin/nologin "$SERVICE_USER"
  fi
}

# The edge ports only. SEC-14: 25/tcp is NOT opened here any more — inbound
# SMTP is an opt-in capability, and opening the port on every install left an
# internet-facing mail listener on instances that never use email capture.
# `cogeto features enable mail` opens it (and `disable mail` closes it).
open_firewall() {
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
    say "ufw is active — allowing 80/tcp (ACME+redirect) and 443 (HTTPS)"
    run ufw allow 80/tcp
    run ufw allow 443
    if mail_capability_enabled; then
      say "inbound mail is enabled for this instance — also allowing 25/tcp"
      run ufw allow 25/tcp
    else
      say "inbound mail is OFF (SEC-14) — 25/tcp stays closed; 'cogeto features enable mail' opens it"
    fi
  else
    say "ufw inactive or absent — no host firewall change needed (OVHcloud network firewall, if enabled, must allow 80 and 443, plus 25 only if you enable inbound mail)"
  fi
}

# Whether THIS instance runs inbound mail (SEC-14). One reading of the
# configured state, used by the firewall, the health wait, the status report
# and the install checklist so they can never disagree.
mail_capability_enabled() {
  [ "$(feature_configured mail)" = "enabled" ]
}

# Inbound-mail TLS (issue #566). COGETO_MAIL_TLS_SITE is what makes the edge
# obtain and renew the certificate for the mail hostname: set it and the deploy
# Caddyfile's ACME-only vhost becomes real; leave it empty and that vhost falls
# back to an inert http-only placeholder, so an instance without email capture
# attempts no ACME order at all.
#
# The value is derive_mx_host — the SAME derivation the DNS checklist prints,
# not a second convention — and it is maintained by the script rather than the
# operator, because the whole point is that enabling mail and adding one DNS
# record is the entire procedure.
#
# WHO OWNS THE CERTIFICATE is recorded, not inferred. An operator with their
# own CA supplies cert.pem and key.pem themselves, and the documented way to say
# so used to be "leave COGETO_MAIL_TLS_SITE empty" — which this convergence then
# silently undid on the next upgrade, ordered a certificate the moment
# mail.<domain> resolved, and let the sidecar overwrite their material. An empty
# value cannot carry an intention: it is indistinguishable from an unset one,
# and the next operator cannot tell the difference either. So the intention is a
# value of its own, COGETO_MAIL_TLS_MODE, and this function is the single
# chokepoint every convergence path goes through (upgrade, features
# enable/disable mail, configure --domain).
mail_tls_mode() {  # → automatic | operator
  case "$(env_get COGETO_MAIL_TLS_MODE)" in
    operator) echo operator ;;
    automatic | '') echo automatic ;;
    *)
      warn "COGETO_MAIL_TLS_MODE is '$(env_get COGETO_MAIL_TLS_MODE)', which is not a mode (valid: automatic, operator) — treating it as automatic. Set it with 'cogeto configure --mail-tls-mode MODE'."
      echo automatic ;;
  esac
}

sync_mail_tls_site() {
  if [ "$(mail_tls_mode)" = "operator" ]; then
    # Operator-supplied: touch NOTHING. With the site left as the operator set
    # it (empty), the edge orders no certificate and mail-tls-sync idles, so
    # the material in the mail-tls volume is theirs and stays theirs.
    say "inbound-mail TLS is operator-supplied (COGETO_MAIL_TLS_MODE=operator) — leaving COGETO_MAIL_TLS_SITE and your certificate material untouched. 'cogeto configure --mail-tls-mode automatic' hands it back to the edge."
    return 0
  fi
  smt_domain="$(env_get COGETO_EXTERNAL_DOMAIN)"
  if mail_capability_enabled && [ -n "$smt_domain" ]; then
    env_set COGETO_MAIL_TLS_SITE "$(derive_mx_host "$smt_domain")"
  else
    env_set COGETO_MAIL_TLS_SITE ""
  fi
}

# Close the inbound SMTP port again. Tolerant: ufw absent/inactive, or the rule
# never added, is not an error.
close_mail_firewall() {
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
    say "closing 25/tcp in ufw"
    run ufw delete allow 25/tcp || true
  fi
}

# ── Health wait / health report ───────────────────────────────────────────────

service_health() {  # service_health NAME → healthy|starting|unhealthy|exited:N|missing
  cid="$(compose ps -q "$1" 2>/dev/null | head -n 1)"
  if [ -z "$cid" ]; then echo "missing"; return 0; fi
  state="$(docker inspect -f '{{.State.Status}}' "$cid" 2>/dev/null || echo unknown)"
  if [ "$state" = "exited" ]; then
    echo "exited:$(docker inspect -f '{{.State.ExitCode}}' "$cid")"
    return 0
  fi
  health="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null || echo unknown)"
  if [ "$health" = "none" ]; then echo "$state"; else echo "$health"; fi
}

wait_healthy() {
  # SEC-14: mail is part of the health bar only when the capability is on.
  if mail_capability_enabled; then wh_services="app, worker, caddy, mail"; else wh_services="app, worker, caddy"; fi
  if [ "$CHECK" -eq 1 ]; then
    say "[dry-run] would wait for ${wh_services} to report healthy (up to 5 minutes)"
    return 0
  fi
  say "waiting for the stack to become healthy (Zitadel's first init takes a minute)..."
  deadline=$(( $(date +%s) + 300 ))
  while :; do
    app="$(service_health app)"; workr="$(service_health worker)"
    caddy="$(service_health caddy)"
    if mail_capability_enabled; then mail="$(service_health mail)"; else mail="healthy"; fi
    if [ "$app" = "healthy" ] && [ "$workr" = "healthy" ] && [ "$caddy" = "healthy" ] && [ "$mail" = "healthy" ]; then
      say "stack healthy: ${wh_services} all report healthy"
      return 0
    fi
    if [ "$(date +%s)" -ge "$deadline" ]; then
      warn "stack did not become healthy in 5 minutes (app=${app} worker=${workr} caddy=${caddy} mail=${mail})"
      warn "inspect with: cd ${COGETO_ROOT} && docker compose ps && docker compose logs --tail 100 app"
      return 1
    fi
    sleep 5
  done
}

# The app's aggregate health endpoint (/api/health). Not public since SEC-3:
# it authenticates, and a caller without the admin role gets the verdicts with
# the operational detail trimmed. This call runs INSIDE the app container over
# loopback, which the health guard treats as the operator path — full detail, no
# token needed. Do not repoint it at the edge; from there it would need one.
# covers Postgres, Qdrant, MinIO + encryption, integrity sweep, migrations,
# queue depth/dead-letter, model gateway, and mail. Fetched from INSIDE the app
# container so it works before DNS points anywhere.
fetch_health_report() {
  compose exec -T app node -e '
    fetch("http://127.0.0.1:3000/api/health")
      .then((r) => r.json())
      .then((j) => {
        console.log("overall: " + j.status);
        for (const [name, c] of Object.entries(j.checks)) {
          const mark = c.ok ? "ok  " : "FAIL";
          const extra = c.error ? " — " + c.error : c.detail ? " — " + c.detail : "";
          console.log("  " + mark + "  " + name + extra);
        }
        process.exit(j.status === "ok" ? 0 : 1);
      })
      .catch((e) => { console.log("unreachable: " + e.message); process.exit(1); });
  ' 2>/dev/null
}

# ── Checklist builders ────────────────────────────────────────────────────────

add_install_checklist() {
  domain="$1"; inbound="$2"; ip="$3"
  mx_sub="$(derive_inbound_subdomain "$domain")"
  mx_host="$(derive_mx_host "$domain")"

  todo_now "OVHcloud DNS (Web Cloud → Domain names → zone → Add an entry) → app A record:      ${domain}.  IN A  ${ip}"
  todo_now "OVHcloud DNS → presign-origin A record: s3.${domain}.  IN A  ${ip}"
  # SEC-14: the mail host, MX, PTR and SPF steps exist ONLY to point real mail
  # at an SMTP listener. With inbound mail off, no listener runs and every one
  # of them would be a checklist item for something that is not there.
  if mail_capability_enabled; then
    todo_now "OVHcloud DNS → mail host A record:      ${mx_host}.  IN A  ${ip}"
    todo_now "OVHcloud DNS → inbound MX record:       ${mx_sub}.  IN MX 10  ${mx_host}."
    todo_now "OVHcloud panel (Public Cloud → Network → Public IPs → ${ip} → Edit the reverse) → set the PTR to ${mx_host} — do this AFTER the ${mx_host} A record resolves; senders soft-reject hosts without matching forward/reverse DNS"
    todo_now "SPF note: receiving needs no SPF, but if the apex domain publishes a strict SPF, confirm it does not cover ${mx_sub} (Cogeto never sends — no outbound SPF/DKIM/DMARC needed)"
  else
    todo_now "Email capture is OFF on this instance (audit 2.0 SEC-14: no inbound SMTP listener runs, and 25/tcp is closed). If the customer wants it, run 'sudo cogeto features enable mail' — it opens the port and prints the MX/PTR steps then."
  fi
  todo_now "NOTE on the records above: propagation takes minutes up to the zone TTL (check: dig +short A ${domain}); Caddy keeps retrying and obtains the TLS certificate AUTOMATICALLY once the A record resolves — no restart, no action. Until then the browser shows a certificate warning; that is expected."
  todo_now "OVHcloud panel → enable Automated Backup for this instance (roadmap D4; run 'cogeto backup-info' for the exact settings)"
  if mail_capability_enabled; then
    todo_now "If the OVHcloud Network Firewall is enabled for this IP: allow inbound TCP 80, 443, and 25"
  else
    todo_now "If the OVHcloud Network Firewall is enabled for this IP: allow inbound TCP 80 and 443 (25 is not needed — email capture is off)"
  fi

  todo_dns "Open https://${domain} — a valid Let's Encrypt certificate is served and the login page loads (Caddy retries ACME automatically once DNS resolves; no restart needed)"
  todo_dns "Create the customer's user: open the Zitadel Console at https://${domain}/ui/console, sign in as admin@${domain} (password = ZITADEL_ADMIN_PASSWORD in ${ENV_FILE}), Users → + New — choose 'Set initial password' and hand it over out-of-band. NEVER 'Send an email invitation': the instance has no outbound SMTP, so invitations silently never arrive."
  todo_dns "Configure a model provider: log in at https://${domain} as an administrator, open Providers (left rail), add the provider and its API key, then assign the pipeline, answer and embeddings models under Models. Capture, ingestion and chat are OFF until this is done — the interface says so on every page, and no restart is needed after."
  if mail_capability_enabled; then
    todo_dns "Email capture test (sender-routed): have the CUSTOMER forward any email FROM THEIR OWN ADDRESS (the one their user is registered with) to ${inbound} — it is captured for them with no configuration. External senders they auto-forward from are added to THEIR allowlist (Settings → Email capture); the operator admin account never captures."
  fi
  todo_dns "Export a Memory Passport (dashboard → Passport) and confirm the download"
  todo_dns "Delete a test source and confirm Forgotten shows a signed deletion receipt"
  todo_dns "Run 'sudo cogeto status' on the instance — everything green (the script installed itself to /usr/local/bin/cogeto)"

  todo_vault "Store ${ENV_FILE} (all per-instance secrets) in the operator vault — losing MINIO_KMS_SECRET_KEY makes stored files unreadable, and losing COGETO_MASTER_KEY makes every stored provider API key unreadable"
  todo_vault "Record the Zitadel admin login (admin@${domain} + ZITADEL_ADMIN_PASSWORD from ${ENV_FILE})"
  todo_vault "Note: the receipt-signing keypair is generated on first boot INSIDE the 'instance-keys' Docker volume (never a file on disk) — it is covered by the OVHcloud instance backup, not by ${ENV_FILE}"
}

# ── install ───────────────────────────────────────────────────────────────────

cmd_install() {
  domain=""; acme_email=""; version=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --domain)      domain="$2"; shift 2 ;;
      --acme-email)  acme_email="$2"; shift 2 ;;
      --version)     version="$2"; shift 2 ;;
      --mistral-key) die "install: --mistral-key is gone — model providers are configured in the interface after login (Providers in the left rail), never in the environment" ;;
      *) die "install: unknown argument '$1' (see --help)" ;;
    esac
  done

  say "install — first-time setup of a Cogeto customer instance (pull-only)"
  require_root
  check_os
  check_resources

  if [ -f "$ENV_FILE" ]; then
    die "already installed: ${ENV_FILE} exists. Use 'cogeto upgrade' to change version, 'cogeto configure' to change configuration. (To reinstall from scratch, remove ${COGETO_ROOT} and the Docker volumes YOURSELF — this script never deletes data.)"
  fi

  version_label="explicitly requested"
  if [ -z "$version" ]; then
    say "resolving the latest published release..."
    version="$(resolve_latest_version)"
    [ -n "$version" ] || die "could not resolve the latest published release (network?) — pass --version X.Y.Z"
    version_label="latest published release"
  fi
  semver_valid "$version" || die "--version must be X.Y.Z (got '${version}')"
  require_supported_version "$version"

  # The operator always sees and confirms the version before anything happens.
  if [ "$CHECK" -eq 1 ]; then
    say "[dry-run] would ask: install Cogeto v${version} (${version_label})?"
  else
    printf '%s install Cogeto v%s (%s)? [y/N] ' "$SAY_PREFIX" "$version" "$version_label"
    IFS= read -r install_reply
    case "$install_reply" in
      y | Y | yes | YES) ;;
      *) die "aborted — nothing was changed" ;;
    esac
  fi

  # Gather instance identity. In --check mode, placeholders keep the dry run going.
  if [ -z "$domain" ]; then
    if [ "$CHECK" -eq 1 ]; then domain="instance.example.com"; say "[dry-run] no --domain given — using placeholder ${domain}"; else
      printf '%s app domain for this instance (e.g. acme.cogeto.eu): ' "$SAY_PREFIX"; IFS= read -r domain
    fi
  fi
  domain="$(printf '%s' "$domain" | tr '[:upper:]' '[:lower:]')"
  domain_valid "$domain" || die "'${domain}' is not a valid domain name"
  if [ -z "$acme_email" ]; then
    if [ "$CHECK" -eq 1 ]; then acme_email="ops@example.com"; say "[dry-run] no --acme-email given — using placeholder ${acme_email}"; else
      printf "%s operator email for Let's Encrypt expiry notices: " "$SAY_PREFIX"; IFS= read -r acme_email
    fi
  fi

  inbound="$(derive_inbound_address "$domain")"
  say "instance identity: https://${domain} — inbound email address: ${inbound}"

  # Published-release gate (skipped in check mode only if the network is absent).
  if hub_tag_exists "$version"; then
    say "release ${version} is published on Docker Hub"
  else
    if [ "$CHECK" -eq 1 ]; then warn "could not confirm ${IMAGE}:${version} on Docker Hub (offline check run?)"; else
      die "${IMAGE}:${version} is not a published release — the instance only ever pulls published, signed images"
    fi
  fi

  install_docker
  install_cosign
  install_self
  ensure_service_user
  say "creating instance directory ${COGETO_ROOT}"
  run mkdir -p "$COGETO_ROOT"
  fetch_deploy_assets "$version"

  say "generating per-instance secrets → ${ENV_FILE} (mode 600; values are never logged)"
  env_set COGETO_VERSION "$version"
  env_set COGETO_EXTERNAL_DOMAIN "$domain"
  env_set COGETO_ACME_EMAIL "$acme_email"
  env_set COGETO_S3_PUBLIC_URL "$(derive_s3_origin "$domain")"
  env_set POSTGRES_PASSWORD "$(gen_password)"
  # Least-privilege data plane (audit 2.0 wave 3, SEC-1/SEC-2/SEC-16): the
  # runtime and migration DB roles, Zitadel's non-superuser DB admin, the
  # scoped S3 credential, and a short bootstrap-PAT expiry (zitadel-init also
  # revokes the PAT once provisioning succeeds — the expiry is the backstop).
  env_set COGETO_APP_DB_PASSWORD "$(gen_password)"
  env_set COGETO_MIGRATE_DB_PASSWORD "$(gen_password)"
  env_set ZITADEL_DB_ADMIN_PASSWORD "$(gen_password)"
  env_set COGETO_S3_ACCESS_KEY "cogeto-app"
  env_set COGETO_S3_SECRET_KEY "$(gen_password)"
  env_set ZITADEL_BOOTSTRAP_PAT_EXPIRY "$(gen_bootstrap_pat_expiry)"
  env_set MINIO_ROOT_USER "cogeto"
  env_set MINIO_ROOT_PASSWORD "$(gen_password)"
  env_set MINIO_KMS_SECRET_KEY "$(gen_minio_kms_key)"
  # The instance master key (V2.4 item 7.1): what encrypts the provider API
  # keys the admin enters in the interface. DATA-BOUND like the MinIO KMS key
  # — losing it makes every stored provider key unreadable, and there is no
  # recovery except re-entering them.
  env_set COGETO_MASTER_KEY "$(gen_master_key)"
  env_set ZITADEL_MASTERKEY "$(gen_zitadel_masterkey)"
  env_set ZITADEL_DB_PASSWORD "$(gen_password)"
  env_set ZITADEL_ORG_NAME "Cogeto"
  env_set ZITADEL_ADMIN_USERNAME "admin@${domain}"
  env_set ZITADEL_ADMIN_PASSWORD "$(gen_zitadel_admin_password)"
  env_set COGETO_QDRANT_API_KEY "$(gen_token)"
  env_set COGETO_MAIL_INBOUND_ADDRESS "$inbound"
  env_set COGETO_MAIL_INTAKE_TOKEN "$(gen_token)"
  if [ "$CHECK" -eq 0 ]; then
    chown -R "${SERVICE_USER}:${SERVICE_USER}" "$COGETO_ROOT" 2>/dev/null || true
    chmod 600 "$ENV_FILE"
  fi

  open_firewall

  say "pulling the prebuilt signed images (${IMAGE}, ${IMAGE_EDGE}, ${IMAGE_MAIL} @ ${version}) — the instance never builds"
  run compose pull --quiet
  verify_images "$version"

  say "bringing the stack up (init jobs → migrations → app/worker/edge/mail)"
  run compose up -d
  wait_healthy || true

  if [ "$CHECK" -eq 0 ]; then
    say "aggregate application health:"
    fetch_health_report || warn "health is not fully green yet — re-check with 'cogeto status' (TLS needs DNS; a fresh instance has no model provider yet, which is normal and does not degrade health)"
  fi

  say "TLS: Caddy requests the Let's Encrypt certificate automatically and keeps retrying until the DNS A record resolves to this host — no further action beyond the DNS records below"
  add_install_checklist "$domain" "$inbound" "$(detect_public_ip)"
  print_checklist
}

# ── upgrade ───────────────────────────────────────────────────────────────────

require_installed() {
  [ -f "$ENV_FILE" ] || die "no instance found at ${COGETO_ROOT} (missing .env) — run 'cogeto install' first, or pass --root"
}

# The version the app container is ACTUALLY running, or empty when no app
# container exists (a stack that never came up, or one that is stopped).
#
# WHY THIS EXISTS. `upgrade` used to take "which version is this instance on?"
# from COGETO_VERSION in .env, which the same function wrote BEFORE pulling
# anything. So an upgrade that failed at the pull left a file claiming the new
# version while the old containers kept serving, and the next run compared the
# target against that claim and refused: "already on vX, nothing to do". A
# failed upgrade was indistinguishable from a finished one AND it closed its own
# retry path. Observed on a customer instance at v1.7.3.
#
# `cogeto status` already reads the running image and reports the mismatch
# honestly; this is that same reading, used by the code that has to decide.
running_app_version() {
  riv_cid="$(compose ps -q app 2>/dev/null | head -n 1)"
  [ -n "$riv_cid" ] || return 0
  riv_image="$(docker inspect -f '{{.Config.Image}}' "$riv_cid" 2>/dev/null || true)"
  case "$riv_image" in
    "${IMAGE}:"*) printf '%s' "${riv_image#"${IMAGE}":}" ;;
    *) : ;;
  esac
}

cmd_upgrade() {
  target="${1:-latest}"
  require_root
  require_installed
  # Self-heal the PATH install (issue #60): an operator who fetched a fresh
  # copy of this script and ran `upgrade` must still end up with a working
  # `sudo cogeto <cmd>` — install-time-only self-install proved insufficient.
  install_self
  configured="$(env_get COGETO_VERSION)"
  [ -n "$configured" ] || die "COGETO_VERSION missing from ${ENV_FILE} — the instance is misconfigured"
  # What is RUNNING outranks what is recorded, always. They differ exactly when
  # a previous upgrade did not finish, which is the case that must be resumable.
  running="$(running_app_version)"
  current="${running:-$configured}"

  target_label="explicitly requested"
  if [ "$target" = "latest" ]; then
    say "resolving the latest published release..."
    target="$(resolve_latest_version)"
    [ -n "$target" ] || die "could not resolve the latest published version (network?) — pass an explicit version"
    target_label="latest published release"
  fi
  semver_valid "$target" || die "target version must be X.Y.Z or 'latest' (got '${target}')"
  require_supported_version "$target"

  if [ -n "$running" ] && [ "$running" != "$configured" ]; then
    warn "this instance is INCONSISTENT: ${ENV_FILE} records v${configured}, but the app container is running v${running}. That is what a previous upgrade looks like when it stopped partway (a failed image pull or signature check). Going by what is RUNNING."
  fi
  say "upgrade: current v${current} → target v${target} (${target_label})"

  # The only "nothing to do": the containers already run the target. A .env that
  # merely CLAIMS the target is not evidence, and treating it as evidence is
  # what made a half-finished upgrade unrepeatable.
  if [ "$running" = "$target" ]; then
    say "already on v${target} — the app container is running ${IMAGE}:${target}, nothing to do (re-run 'cogeto status' to verify health)"
    if [ "$configured" != "$target" ]; then
      env_set COGETO_VERSION "$target"
      say "corrected ${ENV_FILE}: it recorded v${configured} while v${target} was running"
    fi
    print_checklist
    return 0
  fi

  cmp="$(version_cmp "$target" "$current")"
  if [ -z "$running" ] && [ "$cmp" = "0" ]; then
    # No app container at all, so there is nothing to compare against and the
    # recorded version is all there is. Say what is missing rather than
    # reporting a healthy no-op: an instance with no app container is not fine.
    say "the recorded version is already v${target}, and no app container is running, so there is nothing to compare it against."
    warn "NOTHING IS RUNNING. If a previous upgrade or install stopped partway, bring the stack up with: cd ${COGETO_ROOT} && sudo docker compose up -d — then 'sudo cogeto status'."
    print_checklist
    return 0
  fi

  if ! hub_tag_exists "$target"; then
    die "${IMAGE}:${target} is not a published release — refusing to upgrade to an unpublished tag"
  fi

  # Migrations are forward-only: without a fresh backup there is no way back
  # to the pre-upgrade state (runbook section 5). The operator confirms one
  # exists before anything changes.
  confirm_typed "BACKED-UP" "confirm a fresh backup exists before changing the instance — database migrations are forward-only, and the only full rollback is the rehearsed backup restore."

  if [ "$cmp" = "-1" ]; then
    warn "v${target} is OLDER than the running v${current} — this is a ROLLBACK. Database migrations are forward-only: rolling back the image does NOT roll back the schema. Roll back data by restoring the OVHcloud backup (see the runbook)."
    confirm_typed "ROLLBACK to ${target}" "rolling the image back while keeping the newer schema can break the instance."
  elif [ "$cmp" = "0" ]; then
    # Reached only as a RESUME: the recorded version already says the target,
    # and the running one does not.
    confirm_typed "resume upgrade to ${target}" "this finishes an upgrade that did not complete: it pulls ${IMAGE}[-edge|-mail]:${target} again, re-runs the migration job, and restarts app and worker (short downtime)."
  else
    confirm_typed "upgrade to ${target}" "this pulls ${IMAGE}[-edge|-mail]:${target}, re-runs the migration job, and restarts app and worker (short downtime)."
  fi

  # Signature verification is mandatory — make sure the
  # verifier exists before anything is mutated (older instances installed it
  # optionally at install time).
  install_cosign

  # Deployment files are versioned with the images — fetch the matching set.
  fetch_deploy_assets "$target"
  # The compose file interpolates ${COGETO_VERSION}, so the pull and the up
  # below need the target — but it is EXPORTED for those child processes, not
  # written into .env. A shell value beats the .env file in compose's own
  # precedence, so the two commands see the target while the recorded version
  # keeps telling the truth until the containers actually run it. It is written
  # to .env after `compose up` succeeds, and not before: a version recorded ahead
  # of the work it describes is the defect this whole ordering exists to remove.
  COGETO_VERSION="$target"
  export COGETO_VERSION
  # New-in-this-release secrets the fetched compose requires (idempotent).
  ensure_wave3_secrets
  # SEC-14: keep an instance that was already receiving email receiving it.
  carry_forward_mail_capability
  # Inbound-mail TLS (issue #566): converge COGETO_MAIL_TLS_SITE with whatever
  # the mail capability now is. This is also the backfill for an instance that
  # was receiving email before the certificate was obtained automatically —
  # after this upgrade it stops being cleartext with no operator step.
  sync_mail_tls_site

  say "pulling v${target} images (never building)"
  # Every failure below says WHAT failed and that nothing changed. Before this,
  # `set -e` killed the run with no message of its own, leaving an operator with
  # a dead terminal, no stated cause, and (until the ordering above) a .env that
  # lied about the version.
  if ! run compose pull --quiet; then
    die "PULLING THE v${target} IMAGES FAILED — the instance was NOT changed and is still running v${current}. Common causes, in order: a Docker Hub pull-rate limit on anonymous pulls (fix: 'sudo docker login' on this host, then re-run — authenticated pulls get a far higher allowance), a network or DNS problem, or an image that is not published yet if you tagged the release moments ago. Diagnose with: sudo docker pull ${IMAGE}:${target}. Then re-run 'sudo cogeto upgrade ${target}' — it resumes."
  fi
  verify_images "$target"

  say "applying: init jobs re-run (preflight → migrate) and changed services restart"
  if ! run compose up -d --remove-orphans; then
    die "STARTING THE v${target} STACK FAILED — the images are pulled and verified, but compose could not bring the services up. The recorded version is still v${configured}; inspect with: cd ${COGETO_ROOT} && sudo docker compose ps && sudo docker compose logs --tail 100 app. Re-running 'sudo cogeto upgrade ${target}' resumes from here."
  fi
  # From here the containers ARE the target, so this is the first moment the
  # instance is honestly on it. Recorded before the health wait deliberately:
  # health can lag or fail, and the version would still be the running one.
  env_set COGETO_VERSION "$target"
  wait_healthy || true

  if [ "$CHECK" -eq 0 ]; then
    say "post-upgrade health:"
    fetch_health_report || warn "health not fully green — inspect 'cogeto status' before handing the instance back"
    check_embedding_model
  fi

  # Disk hygiene, last, and only after the new version is actually up: every
  # release is roughly a gigabyte across the four images, and an instance that
  # never cleans up accumulates every version it has ever run. The version we
  # came FROM is kept, because it is the rollback named on the next line.
  prune_old_images "$target" "$current"

  say "rollback, if this upgrade misbehaves: 'cogeto upgrade ${current}' (typed ROLLBACK confirmation; the v${current} images are still on this host, so it needs no network; schema stays at v${target} — full data rollback is the rehearsed OVHcloud-backup restore)"
  todo_dns "Log in at https://$(env_get COGETO_EXTERNAL_DOMAIN) and confirm the release works (version shows v${target} in the nav footer)"
  todo_now "Run 'sudo cogeto status' and confirm everything is green"
  print_checklist
}

# After an upgrade the configured embedding model may differ from the model
# recorded on existing memories (migration 0004) — then the Qdrant index must
# be rebuilt from Postgres (spec §4.2: reindex must always work).
check_embedding_model() {
  # The DATABASE is the only source of the embeddings model. No assignment
  # yet (a first-run instance with no provider configured) means no vectors
  # were ever produced, so there is nothing to reindex and nothing to check.
  configured="$(compose exec -T postgres psql -U postgres -d cogeto -tA \
    -c "SELECT model FROM model_assignment WHERE tier = 'embeddings'" 2>/dev/null || echo "")"
  if [ -z "$configured" ]; then
    say "no embeddings model is assigned yet (models are configured in the interface) — nothing to reindex"
    return 0
  fi
  stale="$(compose exec -T postgres psql -U postgres -d cogeto -tA \
    -c "SELECT count(*) FROM memory WHERE embedding_model IS NOT NULL AND embedding_model <> '${configured}'" 2>/dev/null || echo "")"
  if [ -z "$stale" ]; then
    warn "could not check the recorded embedding model (postgres not reachable?) — if the release notes mention an embedding-model change, run 'cogeto reindex'"
    return 0
  fi
  if [ "$stale" = "0" ]; then
    say "embedding model unchanged ('${configured}') — no reindex needed"
    return 0
  fi
  warn "${stale} memories were embedded with a DIFFERENT model than the configured '${configured}' — the vector index must be rebuilt (re-embeds via the model API; costs API calls)"
  confirm_typed "REINDEX" "rebuild the Qdrant index from Postgres now (the app keeps running; spec §4.2)."
  run compose run --rm -T worker node project/src/dist/entrypoints/reindex.js
}

# ── reindex ───────────────────────────────────────────────────────────────────

# The operator path over the vector index (V2.4 item 7.1 second half). Shares
# the application's own implementation — the entrypoint drives the same rebuild
# engine and the same switch path the interface uses — rather than duplicating
# any of it here. 'compose run' rather than 'exec': it starts a fresh container
# from the worker image, so it works while the app and worker services are
# refusing to start (the exact situation this repairs).
cmd_reindex() {
  require_installed
  provider=""
  model=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --provider) provider="$2"; shift 2 ;;
      --model)    model="$2"; shift 2 ;;
      *) die "unknown argument '$1' — usage: cogeto reindex [--provider LABEL --model MODEL]" ;;
    esac
  done
  if [ -n "$provider" ] && [ -z "$model" ]; then
    die "--provider needs --model: the target embeddings model to move to"
  fi
  if [ -n "$model" ]; then
    target_desc="'${model}'"
    [ -n "$provider" ] && target_desc="${target_desc} on provider '${provider}'"
    say "This moves the instance's embeddings model to ${target_desc}."
    say "The whole corpus is re-embedded into a new index while the current one keeps"
    say "serving; the switch happens only on verified completion. Re-embedding costs"
    say "model API calls; an interrupted run resumes from where it stopped."
    confirm_typed "REINDEX" "re-embed the whole corpus and switch the embeddings model at completion."
  else
    say "This rebuilds the vector index in place from Postgres with the ACTIVE embeddings"
    say "model — the repair for the mismatch the boot guard refuses. Rows whose vectors"
    say "are current are reused; the rest are re-embedded (costs model API calls)."
    confirm_typed "REINDEX" "rebuild the Qdrant index from Postgres now (spec §4.2)."
  fi
  if [ "$CHECK" -eq 1 ]; then
    say "CHECK MODE — would run: compose run --rm worker node project/src/dist/entrypoints/reindex.js${provider:+ --provider ${provider}}${model:+ --model ${model}}"
    return 0
  fi
  if [ -n "$model" ]; then
    if [ -n "$provider" ]; then
      run compose run --rm -T worker node project/src/dist/entrypoints/reindex.js --provider "$provider" --model "$model"
    else
      run compose run --rm -T worker node project/src/dist/entrypoints/reindex.js --model "$model"
    fi
  else
    run compose run --rm -T worker node project/src/dist/entrypoints/reindex.js
  fi
}

# ── status ────────────────────────────────────────────────────────────────────

cmd_status() {
  require_installed
  domain="$(env_get COGETO_EXTERNAL_DOMAIN)"
  version="$(env_get COGETO_VERSION)"
  inbound="$(env_get COGETO_MAIL_INBOUND_ADDRESS)"
  green=1

  echo "── Cogeto instance status ──────────────────────────────────────────────"
  echo " configured version : v${version}"
  echo " domain             : https://${domain}"
  echo " inbound email      : ${inbound}"

  # Running version — what the containers actually run, not what .env says.
  app_cid="$(compose ps -q app 2>/dev/null | head -n 1 || true)"
  running_image=""
  if [ -n "$app_cid" ]; then
    running_image="$(docker inspect -f '{{.Config.Image}}' "$app_cid" 2>/dev/null || true)"
  fi
  echo " running image      : ${running_image:-NOT RUNNING}"
  case "$running_image" in
    "${IMAGE}:${version}") : ;;
    "") warn "app container is not running"; green=0 ;;
    *) warn "running image (${running_image}) differs from configured v${version} — an upgrade or restart did not complete"; green=0 ;;
  esac

  echo
  echo " containers:"
  status_services="caddy app worker postgres qdrant minio zitadel"
  mail_capability_enabled && status_services="caddy app worker mail postgres qdrant minio zitadel"
  for svc in $status_services; do
    h="$(service_health "$svc")"
    printf '   %-10s %s\n' "$svc" "$h"
    [ "$h" = "healthy" ] || [ "$h" = "running" ] || green=0
  done

  echo
  echo " application health (/api/health — includes last migration, queue depth,"
  echo " dead-letter count, deletion-sweep state, bucket encryption, mail):"
  if fetch_health_report; then :; else green=0; fi

  # Model configuration, read from the RUNNING APP's capability registry —
  # the authoritative source. This script never reads it from .env, because
  # .env holds no model configuration: it is impossible for this line to
  # report a working configuration that does not exist. "not configured" is a
  # normal state (a fresh install before the admin adds a provider), stated
  # plainly and never counted against the verdict.
  echo
  echo " model provider (from the running app; configured in the interface):"
  if ! compose exec -T app node -e '
    fetch("http://127.0.0.1:3000/api/health")
      .then((r) => r.json())
      .then((j) => {
        const models = (j.capabilities ?? []).find((c) => c.id === "models");
        if (!models) { console.log("   unknown — the registry did not report the models entry"); process.exit(1); }
        console.log("   " + (models.state === "on" ? "configured" : "NOT CONFIGURED") + (models.detail ? " — " + models.detail : ""));
        process.exit(0);
      })
      .catch((e) => { console.log("   unreachable: " + e.message); process.exit(1); });
  ' 2>/dev/null; then green=0; fi

  echo
  echo " TLS certificate for ${domain}:"
  cert_end="$(echo | openssl s_client -connect 127.0.0.1:443 -servername "$domain" 2>/dev/null | openssl x509 -noout -enddate -issuer 2>/dev/null || true)"
  if [ -n "$cert_end" ]; then
    printf '%s\n' "$cert_end" | while IFS= read -r line; do printf '   %s\n' "$line"; done
    if echo "$cert_end" | grep -qi "let's encrypt\|ZeroSSL"; then
      echo "   Caddy renews automatically ~30 days before expiry — no operator action."
    else
      warn "the served certificate is not from a public CA yet — DNS for ${domain} likely does not point here yet (Caddy keeps retrying ACME; no restart needed)"
      green=0
    fi
  else
    warn "could not read a certificate on :443 — is the caddy container running?"
    green=0
  fi

  # Inbound-mail TLS (issue #566). Before this, a cleartext downgrade was
  # completely silent: the container logged one line at boot, the health check
  # was a bare TCP connect, and neither status nor the capability surface
  # mentioned TLS at all. What is checked here is the OBSERVABLE fact, an SMTP
  # EHLO against the running listener, not whether a file exists somewhere.
  if mail_capability_enabled; then
    echo
    echo " inbound mail TLS (STARTTLS on port 25):"
    mail_host="$(derive_mx_host "$domain")"
    mail_tls="$(echo | openssl s_client -starttls smtp -connect 127.0.0.1:25 -servername "$mail_host" 2>/dev/null \
      | openssl x509 -noout -enddate -issuer 2>/dev/null || true)"
    if [ -n "$mail_tls" ]; then
      echo "   STARTTLS is advertised and the handshake completes"
      printf '%s\n' "$mail_tls" | while IFS= read -r line; do printf '   %s\n' "$line"; done
      if [ "$(mail_tls_mode)" = "operator" ]; then
        echo "   This certificate is OPERATOR-SUPPLIED (COGETO_MAIL_TLS_MODE=operator):"
        echo "   nothing here renews it, and nothing here overwrites it. Renew it"
        echo "   yourself before the date above (docs/operations/email-inbound.md)."
      else
        echo "   Renewal is automatic: the edge renews the ${mail_host} certificate,"
        echo "   mail-tls-sync copies it in, and the mail service reloads it. No action."
      fi
    elif [ "$(mail_tls_mode)" = "operator" ]; then
      warn "inbound mail is running in CLEARTEXT and this instance is in OPERATOR-SUPPLIED certificate mode, so nothing will fix it by itself: place cert.pem and key.pem for ${mail_host} in the mail-tls volume, owned by uid 1000 with mode 0644 and 0640 (root-only material reads to the mail service as no material at all). The exact procedure is in docs/operations/email-inbound.md. To hand the certificate back to the edge instead: 'sudo cogeto configure --mail-tls-mode automatic'."
      green=0
    else
      warn "inbound mail is running in CLEARTEXT: STARTTLS is not advertised on port 25. Senders that require TLS will refuse, and everything else arrives unencrypted. Usual cause: the ${mail_host} A record does not resolve to this host yet, so the edge has not obtained the certificate (check: dig +short A ${mail_host}); Caddy keeps retrying and the mail service picks it up within minutes of issuance, with no restart needed. Inspect with: cd ${COGETO_ROOT} && docker compose logs --tail 50 mail-tls-sync"
      green=0
    fi
  fi

  echo
  echo " disk:"
  df -h / | sed 's/^/   /'
  docker system df 2>/dev/null | sed 's/^/   /' || true

  # Obvious misconfigurations.
  if [ -f "$ENV_FILE" ]; then
    perms="$(stat -c '%a' "$ENV_FILE" 2>/dev/null || stat -f '%Lp' "$ENV_FILE" 2>/dev/null || echo '')"
    if [ -n "$perms" ] && [ "$perms" != "600" ]; then
      warn "${ENV_FILE} has mode ${perms} — it holds every secret; fix with: chmod 600 ${ENV_FILE}"
      green=0
    fi
  fi

  echo
  if [ "$green" -eq 1 ]; then
    echo " VERDICT: GREEN — everything this script can observe is actually working."
  else
    echo " VERDICT: NOT GREEN — see the warnings above. This report only says green when it is."
  fi
  echo "────────────────────────────────────────────────────────────────────────"
}

# ── features (P6.7) ────────────────────────────────────────────

# Whether SERVICE exists in the instance's compose file under PROFILE. Returns
# 0 = present, 1 = absent, 2 = cannot tell (no docker; --check on a dev box),
# 3 = `compose config` itself failed (a transient daemon hiccup, a bad .env).
# 1 and 3 MUST stay distinct: a successful read that lacks the service means
# the instance is genuinely behind, but a failed read means nothing about the
# instance, and telling an operator to upgrade over a two-second transient is
# a false alarm (observed in CI, 2026-08-16).
compose_has_service() {  # compose_has_service SERVICE PROFILE
  if ! command -v docker >/dev/null 2>&1; then return 2; fi
  if [ ! -f "$COGETO_ROOT/docker-compose.yml" ]; then return 2; fi
  chs_services="$(compose --profile "$2" config --services 2>/dev/null)" || return 3
  if printf '%s\n' "$chs_services" | grep -qx "$1"; then
    return 0
  fi
  return 1
}

require_feature_service() {  # require_feature_service ID SERVICE PROFILE WHY_ABSENT
  rfs_result=0
  compose_has_service "$2" "$3" || rfs_result="$?"
  case "$rfs_result" in
    0) : ;;
    1)
      if [ "$CHECK" -eq 0 ]; then
        die "cannot enable ${1}: the '${2}' service is not in this instance's compose file. ${4}"
      fi
      warn "cannot verify the '${2}' service exists in the compose file (check mode continues; a real run refuses when it is absent)" ;;
    3)
      if [ "$CHECK" -eq 0 ]; then
        die "cannot enable ${1}: could not read the compose file just now (docker compose config failed). Nothing was changed — try again, and if this persists run 'docker compose config' in ${COGETO_ROOT} to see why."
      fi
      warn "could not read the compose file just now (check mode continues; a real run stops and asks you to retry)" ;;
    *)
      warn "cannot verify the '${2}' service exists in the compose file (check mode continues; a real run refuses when it is absent)" ;;
  esac
}

# The configured (env-level) state of one capability; health is separate.
feature_configured() {  # feature_configured ID → enabled|disabled
  profiles="$(env_get COMPOSE_PROFILES)"
  case "$1" in
    redaction)
      [ "$(env_get REDACTION_ENABLED)" = "1" ] && { echo enabled; return; } ;;
    research)
      { profiles_has "$profiles" research || [ "$(env_get COGETO_RESEARCH_ENABLED)" = "1" ]; } \
        && { echo enabled; return; } ;;
    mail)
      { profiles_has "$profiles" mail || [ "$(env_get COGETO_MAIL_ENABLED)" = "1" ]; } \
        && { echo enabled; return; } ;;
    demo)
      [ "$(env_get COGETO_DEMO_MODE)" = "1" ] && { echo enabled; return; } ;;
    consoles)
      { profiles_has "$profiles" consoles || [ "$(env_get COGETO_CONSOLES_ENABLED)" = "1" ]; } \
        && { echo enabled; return; } ;;
  esac
  echo disabled
}

# Live capability + job report from /api/health (the same registry the System
# panel shows). Fetched from inside the app container; fails → caller degrades.
fetch_capability_report() {
  compose exec -T app node -e '
    fetch("http://127.0.0.1:3000/api/health")
      .then((r) => r.json())
      .then((j) => {
        for (const c of j.capabilities ?? []) {
          const mark = c.state === "on" ? "on " : c.state === "off" ? "off" : "UNREACHABLE";
          const extra = c.error ? " — " + c.error : c.detail ? " — " + c.detail : "";
          console.log("  " + c.id.padEnd(13) + mark + extra);
        }
        for (const job of j.jobs ?? []) {
          const when = job.lastRunAt ? "last ran " + job.lastRunAt : "never ran";
          const state = job.state === "ok" ? "" : " [" + job.state.toUpperCase() + "]";
          const extra = job.error ? " — " + job.error : "";
          console.log("  job:" + job.id.padEnd(9) + when + state + extra);
        }
        process.exit(0);
      })
      .catch((e) => { console.log("  health unreachable: " + e.message); process.exit(1); });
  ' 2>/dev/null
}

wait_service_healthy() {  # wait_service_healthy SERVICE TIMEOUT_SECONDS
  if [ "$CHECK" -eq 1 ]; then
    say "[dry-run] would wait for '${1}' to report healthy"
    return 0
  fi
  say "waiting for '${1}' to become healthy (up to ${2}s)..."
  wsh_deadline=$(( $(date +%s) + $2 ))
  while :; do
    wsh_state="$(service_health "$1")"
    if [ "$wsh_state" = "healthy" ] || [ "$wsh_state" = "running" ]; then
      say "'${1}' is ${wsh_state}"
      return 0
    fi
    if [ "$(date +%s)" -ge "$wsh_deadline" ]; then
      warn "'${1}' did not become healthy in ${2}s (state: ${wsh_state}) — inspect: cd ${COGETO_ROOT} && docker compose logs --tail 50 ${1}"
      return 1
    fi
    sleep 5
  done
}

# Recreate the app + worker (they read the capability env) plus whatever else
# changed, honouring the profile list now in .env.
apply_feature_change() {
  say "applying the new configuration (compose up -d --remove-orphans)"
  run compose up -d --remove-orphans
}

# Stop and remove a disabled profile's service container. Compose does NOT
# treat a profile-disabled service's running container as an orphan (it is
# still defined in the file), so `up --remove-orphans` alone leaves it running
# — observed in the P6.7 dev-stack verification. Tolerant: nothing to stop is
# a no-op, and the deploy channel may not define the service at all.
stop_profile_service() {  # stop_profile_service PROFILE SERVICE
  run compose --profile "$1" stop "$2" || true
  run compose --profile "$1" rm -f "$2" || true
}

features_list() {
  say "capabilities this script switches (configured state from ${ENV_FILE}):"
  for fid in $FEATURE_IDS; do
    printf '  %-13s %s\n' "$fid" "$(feature_configured "$fid")"
  done
  echo
  say "also reported by the registry, decided elsewhere (nothing to switch here):"
  for fid in $FEATURE_IDS_REPORTED_ONLY; do
    printf '  %-13s %s\n' "$fid" "$(feature_decided_by "$fid")"
  done
  app_state="$(service_health app 2>/dev/null || echo missing)"
  if [ "$app_state" = "healthy" ]; then
    echo
    say "live health (/api/health — the same registry the System panel shows):"
    fetch_capability_report || warn "could not read the live registry — see 'cogeto status'"
  else
    say "stack is not running (app: ${app_state}) — health unknown; start the stack and re-run"
  fi
  say "boot banner: every app start logs one 'Capabilities: ...' line with the same truth"
}

features_enable() {
  fid="$1"
  case "$fid" in
    research)
      require_feature_service research searxng research \
        "On a deployed instance, upgrade first: the research profile ships with the deploy channel since."
      # SearXNG needs a per-instance server secret; generate once, keep stable.
      if [ -z "$(env_get SEARXNG_SECRET)" ]; then
        env_set SEARXNG_SECRET "$(gen_token)"
      fi
      # The deploy channel mounts ./searxng/settings.yml — take it from the
      # installed version's deployment artifact when the compose file
      # references it and it is not on disk yet (an instance installed before
      # the file existed). The dev checkout mounts the in-repo file instead.
      if grep -q '\./searxng/settings.yml' "$COGETO_ROOT/docker-compose.yml" 2>/dev/null \
        && [ ! -f "$COGETO_ROOT/searxng/settings.yml" ]; then
        fetch_version="$(env_get COGETO_VERSION)"
        run mkdir -p "$COGETO_ROOT/searxng"
        stage_deploy_artifact "$fetch_version"
        install_asset "project/infra/docker/searxng/settings.yml" "$COGETO_ROOT/searxng/settings.yml"
        release_deploy_artifact
      fi
      env_set COMPOSE_PROFILES "$(profiles_add "$(env_get COMPOSE_PROFILES)" research)"
      apply_feature_change
      wait_service_healthy searxng 120 || true
      wait_service_healthy app 120 || true
      say "research is enabled: discovery runs on THIS instance (SearXNG, internal network only, no vendor, no API key; roughly 100-200 MB RAM). Nothing external to configure."
      ;;
    mail)
      require_feature_service mail mail mail \
        "On a deployed instance, upgrade first: inbound mail moved behind the 'mail' profile in the audit 2.0 SEC-14 release."
      env_set COMPOSE_PROFILES "$(profiles_add "$(env_get COMPOSE_PROFILES)" mail)"
      env_set COGETO_MAIL_ENABLED "1"
      # The edge starts obtaining the mail hostname's certificate the moment
      # the A record below resolves; mail-tls-sync then hands it to the mail
      # service and Haraka advertises STARTTLS. No operator step (issue #566).
      sync_mail_tls_site
      apply_feature_change
      # The listener is only reachable once the host firewall lets 25 in.
      if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
        say "ufw is active — allowing 25/tcp (inbound mail)"
        run ufw allow 25/tcp
      fi
      wait_service_healthy mail 120 || true
      wait_service_healthy app 120 || true
      fe_domain="$(env_get COGETO_EXTERNAL_DOMAIN)"
      fe_inbound="$(env_get COGETO_MAIL_INBOUND_ADDRESS)"
      fe_ip="$(detect_public_ip)"
      say "inbound email capture is enabled: a RECEIVE-ONLY SMTP listener now answers on port 25. It never sends. The allowlist (the real acceptance gate) lives in the app, per user."
      if [ "$(mail_tls_mode)" = "operator" ]; then
        say "inbound TLS is OPERATOR-SUPPLIED on this instance (COGETO_MAIL_TLS_MODE=operator): the edge orders nothing, the sidecar copies nothing, and cert.pem/key.pem in the mail-tls volume stay exactly as you placed them. Renewal is yours — 'cogeto status' reports whether STARTTLS is actually advertised and when your certificate expires. See docs/operations/email-inbound.md."
      else
        say "inbound TLS is AUTOMATIC: once the mail host A record below resolves, the edge obtains the Let's Encrypt certificate for $(derive_mx_host "$fe_domain"), it is copied into the mail service's own volume, and STARTTLS is advertised. Nothing to source, copy or renew — 'cogeto status' reports whether it is actually active and when it expires."
      fi
      todo_now "OVHcloud DNS → mail host A record:      $(derive_mx_host "$fe_domain").  IN A  ${fe_ip}"
      todo_now "OVHcloud DNS → inbound MX record:       $(derive_inbound_subdomain "$fe_domain").  IN MX 10  $(derive_mx_host "$fe_domain")."
      todo_now "OVHcloud panel → set the PTR for ${fe_ip} to $(derive_mx_host "$fe_domain") once that A record resolves — senders soft-reject hosts without matching forward/reverse DNS"
      todo_now "If the OVHcloud Network Firewall is enabled for this IP: allow inbound TCP 25"
      todo_now "Email capture test: forward an email from a registered user's own address to ${fe_inbound} and confirm it appears in their memory"
      ;;
    redaction)
      require_feature_service redaction redaction redaction \
        "On a deployed instance, upgrade first: the redaction sidecar became a published, signed release image and joined the deploy channel in the issue #565 release."
      env_set REDACTION_ENABLED "1"
      # posture: with redaction on, also refuse to boot without it — the
      # enable cannot silently regress to plaintext later.
      env_set REDACTION_REQUIRED "1"
      env_set COMPOSE_PROFILES "$(profiles_add "$(env_get COMPOSE_PROFILES)" redaction)"
      # The sidecar is a pull-only release image like the rest: pull it and
      # VERIFY its signature before it runs, exactly as install/upgrade do for
      # the other three. It is skipped there while the capability is off, so
      # this is the first time this instance sees it.
      say "pulling and verifying the redaction sidecar image (${IMAGE_REDACTION} @ $(env_get COGETO_VERSION))"
      run compose --profile redaction pull --quiet redaction
      verify_images "$(env_get COGETO_VERSION)"
      apply_feature_change
      wait_service_healthy redaction 300 || true
      wait_service_healthy app 120 || true
      say "redaction is enabled and FAIL-CLOSED: every outbound model call is pseudonymized locally first, and if the sidecar is unreachable the call FAILS rather than sending unredacted content"
      say "the sidecar loads a spaCy NER model on first boot, so the first health pass takes up to 90 seconds"
      todo_now "Memory: the redaction sidecar holds ~0.7-1 GB RSS (spaCy en_core_web_lg) and is capped at 2 GB — it is the single largest addition to this instance's footprint. Confirm headroom with 'free -m' (the stack's 8 GB minimum already budgets it)."
      todo_now "Retrieval quality: pseudonymized text embeds less precisely than named text, so entity-anchored retrieval is measurably weaker. This is an INSTANCE-LIFETIME setting — vectors built under one mode are inconsistent with the other, so switching later means a reindex. See docs/security/data-sovereignty-and-redaction.md."
      ;;
    demo)
      # The production guard is respected LOUDLY.
      if [ "$(env_get COGETO_PRODUCTION)" = "1" ] \
        || grep -q "COGETO_PRODUCTION: '1'" "$COGETO_ROOT/docker-compose.yml" 2>/dev/null; then
        die "REFUSING to enable demo: this is a PRODUCTION instance (COGETO_PRODUCTION=1). The demo publishes a shared session token to anyone — it must never run beside real data."
      fi
      require_feature_service demo demo-seed demo \
        "The demo profile is dev-only: its seed image is never published."
      env_set COGETO_DEMO_MODE "1"
      env_set COMPOSE_PROFILES "$(profiles_add "$(env_get COMPOSE_PROFILES)" demo)"
      apply_feature_change
      wait_service_healthy app 120 || true
      todo_now "Demo credentials: docker compose logs demo-seed (or demo-credentials.txt) — the sandbox serves a SHARED session"
      ;;
    consoles)
      require_feature_service consoles caddy-consoles consoles \
        "The consoles profile is dev-only: its edge image is never published."
      env_set COGETO_CONSOLES_ENABLED "1"
      env_set COMPOSE_PROFILES "$(profiles_add "$(env_get COMPOSE_PROFILES)" consoles)"
      apply_feature_change
      wait_service_healthy app 120 || true
      say "consoles are LOCALHOST-ONLY: https://minio.localhost:8443 and https://qdrant.localhost:8443 answer on 127.0.0.1 of this machine only"
      ;;
  esac
}

features_disable() {
  fid="$1"
  case "$fid" in
    research)
      env_set COMPOSE_PROFILES "$(profiles_remove "$(env_get COMPOSE_PROFILES)" research)"
      env_set COGETO_RESEARCH_ENABLED ""
      apply_feature_change
      stop_profile_service research searxng
      say "research is disabled: the SearXNG container is stopped; research requests answer 'search unavailable'"
      ;;
    mail)
      env_set COMPOSE_PROFILES "$(profiles_remove "$(env_get COMPOSE_PROFILES)" mail)"
      env_set COGETO_MAIL_ENABLED ""
      # Stop renewing (and stop attempting) the mail hostname's certificate:
      # with the site empty the edge's ACME-only vhost goes inert again.
      sync_mail_tls_site
      apply_feature_change
      stop_profile_service mail mail
      stop_profile_service mail mail-tls-sync
      close_mail_firewall
      say "inbound email capture is disabled: the SMTP listener is stopped and 25/tcp is closed. Mail sent to the inbound address will bounce at the sender; already-captured email is untouched."
      todo_now "Remove the inbound MX record for $(derive_inbound_subdomain "$(env_get COGETO_EXTERNAL_DOMAIN)") so senders fail fast instead of timing out"
      ;;
    redaction)
      # Destructive-adjacent (the whole point of the capability is that model
      # calls never carry plaintext): the operator types the consequence away.
      confirm_typed "disable redaction" "with redaction OFF, every model call sends PLAINTEXT (names, addresses, content) to the configured model provider."
      env_set REDACTION_ENABLED ""
      env_set REDACTION_REQUIRED ""
      env_set COMPOSE_PROFILES "$(profiles_remove "$(env_get COMPOSE_PROFILES)" redaction)"
      apply_feature_change
      stop_profile_service redaction redaction
      warn "redaction is now OFF — model calls send plaintext to the model provider"
      ;;
    demo)
      env_set COGETO_DEMO_MODE ""
      env_set COMPOSE_PROFILES "$(profiles_remove "$(env_get COMPOSE_PROFILES)" demo)"
      apply_feature_change
      stop_profile_service demo demo-seed
      say "demo mode is disabled; the shared demo session is no longer served (seeded demo data remains until reset/removal)"
      ;;
    consoles)
      env_set COGETO_CONSOLES_ENABLED ""
      env_set COMPOSE_PROFILES "$(profiles_remove "$(env_get COMPOSE_PROFILES)" consoles)"
      apply_feature_change
      stop_profile_service consoles caddy-consoles
      say "consoles are disabled"
      ;;
  esac
}

cmd_features() {
  verb=""; fid=""
  while [ $# -gt 0 ]; do
    case "$1" in
      enable|disable)
        [ -z "$verb" ] || die "features: one verb per run (see --help)"
        verb="$1"; shift ;;
      *)
        if [ -z "$verb" ] || [ -n "$fid" ]; then
          die "features: unknown argument '$1' (see --help)"
        fi
        fid="$1"; shift ;;
    esac
  done
  require_installed

  if [ -z "$verb" ]; then
    features_list
    return 0
  fi

  [ -n "$fid" ] || die "features ${verb}: which capability? Valid ids: ${FEATURE_IDS}"
  if [ "$fid" = "local-models" ]; then
    die "local-models is no longer a script feature: a local runtime is an ordinary model provider now. Configure it in the interface — Providers (add a Self-hosted provider pointing at the runtime's OpenAI-compatible endpoint), then Models (assign the tiers; an embeddings change runs the managed rebuild there)."
  fi
  if feature_reported_only "$fid"; then
    die "'${fid}' is a real capability and the registry reports it, but it is not switched from here — $(feature_decided_by "$fid"). Run 'cogeto features' with no verb to see all nine."
  fi
  feature_known "$fid" || die "unknown capability '${fid}' — valid ids: ${FEATURE_IDS}"
  require_root

  state="$(feature_configured "$fid")"
  if [ "$verb" = "enable" ] && [ "$state" = "enabled" ]; then
    say "${fid} is already enabled — re-applying the configuration (idempotent)"
  fi
  if [ "$verb" = "disable" ] && [ "$state" = "disabled" ]; then
    say "${fid} is already disabled — nothing to change"
    print_checklist
    return 0
  fi

  if [ "$verb" = "enable" ]; then
    features_enable "$fid"
  else
    features_disable "$fid"
  fi

  if [ "$CHECK" -eq 0 ]; then
    echo
    say "resulting capability state:"
    features_list
  fi
  print_checklist
}

# ── configure ─────────────────────────────────────────────────────────────────

cmd_configure() {
  require_root
  require_installed
  # Self-heal the PATH install (issue #60) — same rationale as cmd_upgrade.
  install_self
  new_domain=""; regen=""; tls_mode=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --domain)      new_domain="$2"; shift 2 ;;
      --mistral-key) die "configure: --mistral-key is gone — model providers and their keys are configured in the interface (Providers in the left rail; the change applies without a restart), never in the environment" ;;
      --regenerate)  regen="$2"; shift 2 ;;
      --mail-tls-mode) tls_mode="$2"; shift 2 ;;
      *) die "configure: unknown argument '$1' (see --help)" ;;
    esac
  done

  if [ -z "$new_domain" ] && [ -z "$regen" ] && [ -z "$tls_mode" ]; then
    say "current configuration (secret VALUES are never printed):"
    echo "  domain             = $(env_get COGETO_EXTERNAL_DOMAIN)"
    echo "  version            = $(env_get COGETO_VERSION)"
    echo "  inbound address    = $(env_get COGETO_MAIL_INBOUND_ADDRESS)"
    echo "  s3 public origin   = $(env_get COGETO_S3_PUBLIC_URL)"
    echo "  admin username     = $(env_get ZITADEL_ADMIN_USERNAME)"
    echo "  model providers    = configured in the interface (Providers); this file holds none"
    if [ "$(mail_tls_mode)" = "operator" ]; then
      echo "  inbound mail TLS   = operator-supplied (you own cert.pem/key.pem in the mail-tls volume; nothing here orders, copies or overwrites them, and renewal is yours)"
    else
      echo "  inbound mail TLS   = automatic (the edge obtains and renews it; a sidecar installs it)"
    fi
    say "change with --domain, --regenerate NAME or --mail-tls-mode MODE (see --help)"
    return 0
  fi

  restart_needed=""

  if [ -n "$new_domain" ]; then
    new_domain="$(printf '%s' "$new_domain" | tr '[:upper:]' '[:lower:]')"
    domain_valid "$new_domain" || die "'${new_domain}' is not a valid domain name"
    old_domain="$(env_get COGETO_EXTERNAL_DOMAIN)"
    warn "changing the domain changes the OIDC issuer (all sessions invalidate), the S3 presign origin, and the inbound email address; the OLD inbound address (capture@in.${old_domain}) stops accepting mail"
    confirm_typed "change domain to ${new_domain}" "move this instance from ${old_domain} to ${new_domain}."
    env_set COGETO_EXTERNAL_DOMAIN "$new_domain"
    env_set COGETO_S3_PUBLIC_URL "$(derive_s3_origin "$new_domain")"
    env_set COGETO_MAIL_INBOUND_ADDRESS "$(derive_inbound_address "$new_domain")"
    # The mail hostname moves with the domain, so the certificate the edge
    # obtains must too (issue #566).
    sync_mail_tls_site
    say "note: the Zitadel admin username stays admin@${old_domain} — Zitadel does not rename existing users on a domain change"
    # SEC-16: re-provisioning the OIDC redirect URIs needs a live bootstrap
    # PAT, and zitadel-init revoked it after install. The re-run fails loudly
    # with the same instructions; surface them up front so the operator is not
    # surprised mid-change.
    todo_now "The bootstrap PAT was revoked after install (SEC-16). Before the domain change completes: in the Zitadel console (as $(env_get ZITADEL_ADMIN_USERNAME)) create a new personal access token for the 'cogeto-bootstrap' machine user, write it into the zitadel-machinekey volume as pat.txt, delete bootstrap-state.json next to it, then re-run 'docker compose up -d' (runbook: 'Changing the domain after install')"
    restart_needed="caddy app worker mail zitadel zitadel-init"
    add_install_checklist "$new_domain" "$(derive_inbound_address "$new_domain")" "$(detect_public_ip)"
  fi

  # Who owns the inbound-mail certificate. RECORDED, so every convergence path
  # can honour it and the next operator can read the decision instead of
  # guessing at an empty value.
  if [ -n "$tls_mode" ]; then
    case "$tls_mode" in
      operator)
        env_set COGETO_MAIL_TLS_MODE "operator"
        # The site must be empty for the override to hold: it is what makes the
        # edge's ACME-only vhost inert and mail-tls-sync idle. Blanked HERE,
        # deliberately, and then never touched again by any convergence path.
        env_set COGETO_MAIL_TLS_SITE ""
        say "inbound-mail TLS is now OPERATOR-SUPPLIED. The edge orders no certificate for $(derive_mx_host "$(env_get COGETO_EXTERNAL_DOMAIN)"), the sidecar copies nothing, and cert.pem/key.pem in the mail-tls volume are yours: upgrades, 'features enable/disable mail' and a domain change all leave them alone."
        warn "RENEWAL IS NOW YOURS. Nothing will warn you before your certificate expires except 'cogeto status', which reports whether STARTTLS is advertised and when the certificate ends."
        todo_now "Place your certificate and key in the mail-tls volume with the exact ownership the mail container needs (uid 1000, 0644 for cert.pem and 0640 for key.pem) — the procedure and the reason are in docs/operations/email-inbound.md. Root-only material is indistinguishable from no material at all: the listener stays cleartext and looks healthy."
        todo_now "Diary your certificate's expiry, and re-run 'sudo cogeto status' after each renewal to confirm STARTTLS is still advertised"
        ;;
      automatic)
        if [ "$(mail_tls_mode)" = "operator" ]; then
          confirm_typed "hand mail TLS back to the edge" "switching to automatic means the edge orders a certificate for $(derive_mx_host "$(env_get COGETO_EXTERNAL_DOMAIN)") as soon as that name resolves here, and the sidecar OVERWRITES cert.pem and key.pem in the mail-tls volume with it. Your own certificate stops being used."
        fi
        env_set COGETO_MAIL_TLS_MODE "automatic"
        sync_mail_tls_site
        say "inbound-mail TLS is now AUTOMATIC: the edge obtains and renews it, the sidecar installs it, and nothing needs an operator again."
        ;;
      *)
        die "unknown mail TLS mode '${tls_mode}' — valid: automatic (the edge obtains and renews the certificate) or operator (you supply and renew it; see docs/operations/email-inbound.md)" ;;
    esac
    restart_needed="${restart_needed} caddy mail mail-tls-sync"
  fi

  if [ -n "$regen" ]; then
    case "$regen" in
      COGETO_MAIL_INTAKE_TOKEN)
        confirm_typed "regenerate ${regen}" "rotate the mail-intake shared secret (app + mail restart together; no data impact)."
        env_set COGETO_MAIL_INTAKE_TOKEN "$(gen_token)"
        restart_needed="${restart_needed} app worker mail" ;;
      COGETO_QDRANT_API_KEY)
        confirm_typed "regenerate ${regen}" "rotate the Qdrant API key (qdrant + app + worker restart together; no data impact)."
        env_set COGETO_QDRANT_API_KEY "$(gen_token)"
        restart_needed="${restart_needed} qdrant app worker" ;;
      COGETO_APP_DB_PASSWORD|COGETO_MIGRATE_DB_PASSWORD|ZITADEL_DB_ADMIN_PASSWORD)
        # Rotatable BECAUSE of SEC-1: db-init re-syncs each role's password
        # from .env on every `compose up` (ALTER ROLE ... PASSWORD), so the
        # new value converges before any dependent service starts.
        confirm_typed "regenerate ${regen}" "rotate this Postgres role password (db-init re-syncs it; dependent services restart together; no data impact)."
        env_set "$regen" "$(gen_password)"
        restart_needed="${restart_needed} db-init migrate app worker zitadel" ;;
      COGETO_S3_SECRET_KEY)
        # Rotatable BECAUSE of SEC-2: minio-init re-syncs the scoped MinIO
        # user's secret from .env on every `compose up` (`mc admin user add`
        # updates an existing user in place).
        confirm_typed "regenerate ${regen}" "rotate the scoped S3 credential (minio-init re-syncs it; app + worker restart together; no data impact)."
        env_set COGETO_S3_SECRET_KEY "$(gen_password)"
        restart_needed="${restart_needed} minio-init app worker" ;;
      POSTGRES_PASSWORD|ZITADEL_DB_PASSWORD|MINIO_ROOT_PASSWORD|MINIO_KMS_SECRET_KEY|ZITADEL_MASTERKEY|COGETO_MASTER_KEY)
        die "refusing: ${regen} is DATA-BOUND — the running Postgres/MinIO/Zitadel state was initialized with it, and swapping the env alone bricks the stack (losing MINIO_KMS_SECRET_KEY makes stored objects permanently unreadable; rotating COGETO_MASTER_KEY makes every stored provider API key unreadable). Rotating these is a manual, backed-up procedure — see docs/operations/operator-script.md" ;;
      INSTANCE_SIGNING_KEY|instance-signing-key)
        die "refusing LOUDLY: the receipt-signing keypair is NEVER rotated by this script — every deletion receipt chains to it (spec §11.1), and a silent rotation would break the hash-chain verification that makes forgetting provable. If a rotation is truly required, it is an owner-level, documented procedure with a chain anchor";;
      *)
        die "unknown secret '${regen}' — rotatable here: COGETO_MAIL_INTAKE_TOKEN, COGETO_QDRANT_API_KEY, COGETO_APP_DB_PASSWORD, COGETO_MIGRATE_DB_PASSWORD, ZITADEL_DB_ADMIN_PASSWORD, COGETO_S3_SECRET_KEY" ;;
    esac
  fi

  # SEC-14: `mail` is behind a profile now — naming a profile-disabled service
  # on `compose up` is an error, so drop it (and its TLS sidecar, which rides
  # the same profile) when the capability is off.
  if ! mail_capability_enabled; then
    restart_needed="$(printf '%s' "$restart_needed" | tr ' ' '\n' | grep -v -e '^mail$' -e '^mail-tls-sync$' | tr '\n' ' ')"
  fi
  restart_needed="$(printf '%s' "$restart_needed" | tr -s ' ' | sed 's/^ *//; s/ *$//')"

  if [ -n "$restart_needed" ]; then
    say "applying the new configuration (recreates: ${restart_needed})"
    # Intentional word splitting of the accumulated service names:
    # shellcheck disable=SC2086
    run compose up -d $restart_needed
    wait_healthy || true
    todo_now "Run 'sudo cogeto status' and confirm everything is green"
  fi
  print_checklist
}

# ── backup-info ───────────────────────────────────────────────────────────────

cmd_backup_info() {
  cat <<'INFO'
── OVHcloud backups (roadmap D4 — configured in the OVH panel, not by this script)

Cogeto v1 deliberately ships NO backup scripts: backups use OVHcloud's own
capability, enabled per instance by the operator, and restore is a rehearsed
manual procedure (documented in the operator runbook).

Enable, in the OVHcloud control panel for THIS instance:

 [ ] Public Cloud → your instance → enable "Automated Backup"
     (daily snapshot, retention ≥ 7 days). This snapshots the whole disk:
     all Docker volumes (pg-data, minio-data, qdrant-data, instance-keys,
     zitadel-machinekey, caddy-data) and /srv/cogeto (.env, compose files).
 [ ] If the instance uses attached volumes for Docker data, additionally
     enable volume snapshots on those volumes with the same cadence.
 [ ] Note the backup schedule's hour: pick a low-traffic hour; the nightly
     Cogeto jobs run 03:00–04:00 UTC, so avoid that window.
 [ ] Store the instance .env in the operator vault as well — a snapshot
     protects the box, the vault protects you if the box is gone.
 [ ] Rehearse the restore once per customer: restore the snapshot to a new
     instance, run 'cogeto status', log in, verify a deletion receipt — the
     runbook documents the step-by-step procedure.

What must be covered for a full recovery: the Docker volumes (source of truth:
Postgres; rebuildable: Qdrant via reindex; files: MinIO; the receipt-signing
keypair: instance-keys) plus /srv/cogeto/.env. The signing keypair exists ONLY
in the instance-keys volume — without a snapshot or rehearsed restore it is
unrecoverable, and with it every future receipt would break the chain.
INFO
}

# ── main ──────────────────────────────────────────────────────────────────────

main() {
  cmd=""
  args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) CHECK=1; shift ;;
      --root)  COGETO_ROOT="$2"; shift 2 ;;
      --help|-h|help) usage; exit 0 ;;
      install|configure|upgrade|status|features|reindex|backup-info)
        [ -z "$cmd" ] || die "only one subcommand per run (got '${cmd}' and '$1')"
        cmd="$1"; shift ;;
      *)
        [ -n "$cmd" ] || die "unknown argument '$1' — see 'cogeto --help'"
        args+=("$1"); shift ;;
    esac
  done
  ENV_FILE="${COGETO_ROOT}/.env"
  [ "$CHECK" -eq 1 ] && say "CHECK MODE — validating and printing intentions; nothing will be changed"
  case "$cmd" in
    install)     cmd_install "${args[@]+"${args[@]}"}" ;;
    configure)   cmd_configure "${args[@]+"${args[@]}"}" ;;
    upgrade)     cmd_upgrade "${args[@]+"${args[@]}"}" ;;
    status)      cmd_status "${args[@]+"${args[@]}"}" ;;
    features)    cmd_features "${args[@]+"${args[@]}"}" ;;
    reindex)     cmd_reindex "${args[@]+"${args[@]}"}" ;;
    backup-info) cmd_backup_info ;;
    "")          usage; exit 1 ;;
  esac
}

# Sourcing the file (for unit tests) skips execution; running it executes main.
if [ "${BASH_SOURCE[0]:-$0}" = "$0" ]; then
  main "$@"
fi
