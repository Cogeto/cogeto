# ─────────────────────────────────────────────
# OS / editor junk
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
# (note: .claude/ is intentionally tracked)

# ─────────────────────────────────────────────
# Secrets / environment
# ─────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/
# Instance signing keypair generated for local (non-Docker) runs —.
.instance-keys/

# ─────────────────────────────────────────────
# Language / build artifacts
# ─────────────────────────────────────────────
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
target/

# ─────────────────────────────────────────────
# Local Claude settings
# ─────────────────────────────────────────────
.claude/settings.local.json
*.tsbuildinfo

# ─────────────────────────────────────────────
# The managed provider's rendered configuration (hosted provisioning): per
# instance, never committed. The committed contract is
# project/infra/managed-provider.example.json.
# ─────────────────────────────────────────────
managed-provider/
