# Cogeto — environment for docker compose (copy to .env to override).
# Every variable has a safe DEV default baked into docker-compose.yml, so a
# fresh clone works with zero configuration. NEVER use these defaults on a
# reachable host; provisioning injects real secrets per instance (Technical
# Architecture §10). .env is gitignored — secrets are never committed.

# ── External identity of the instance ─────────────────────────────────────────
# Domain the browser uses; also Zitadel's external domain (Host-based routing).
COGETO_EXTERNAL_DOMAIN=localhost

# ── PostgreSQL (source of truth) ──────────────────────────────────────────────
# Superuser password. Since wave 3 of the audit 2.0 remediation (SEC-1) the
# superuser is BREAK-GLASS ONLY: no long-running service connects with it. The
# db-init one-shot uses it to provision the three least-privilege identities
# below (idempotent, passwords re-sync from .env on every `compose up`).
POSTGRES_PASSWORD=cogeto-dev-password
# The runtime role for app + worker: table-level DML only, no DDL, no TRIGGER
# privilege, cannot connect to the zitadel database.
COGETO_APP_DB_PASSWORD=cogeto-dev-app-db-password
# The schema owner; only the migrate entrypoint connects with it.
COGETO_MIGRATE_DB_PASSWORD=cogeto-dev-migrate-db-password
# Zitadel's bootstrap/migration DB admin (CREATEDB/CREATEROLE, not superuser)
# — distinct from ZITADEL_DB_PASSWORD, which is Zitadel's runtime user.
ZITADEL_DB_ADMIN_PASSWORD=zitadel-dev-admin-password

# ── MinIO (file bytes, S3 API — SSE-S3 encryption at rest) ────
# Root credential: provisioning only (minio-init and the dev console). The app
# and worker use the SCOPED credential below instead (SEC-2).
MINIO_ROOT_USER=cogeto
MINIO_ROOT_PASSWORD=cogeto-dev-password
# Scoped application credential, provisioned by minio-init: put/get/delete/
# list/encryption-read on the cogeto bucket only, no admin API. Rotatable
# (minio-init re-syncs the secret on every `compose up`).
COGETO_S3_ACCESS_KEY=cogeto-app
COGETO_S3_SECRET_KEY=cogeto-dev-app-password
# Console origin behind the Caddy edge — default suits the
# *.localhost setup. Do NOT set MINIO_SERVER_URL (breaks console login; see
#). Presigned downloads use the Host header, not this.
#MINIO_BROWSER_REDIRECT_URL=https://minio.localhost
# Server-side encryption master key (single-node KMS). Format is
# <key-name>:<base64 of 32 random bytes>. Generate a real one per instance:
#   echo "cogeto-instance-key:$(openssl rand -base64 32)"
# The default baked into docker-compose.yml is DEV-ONLY — never rely on it on a
# reachable host. Losing this key makes stored objects unreadable; back it up
# with the instance secrets. Key rotation requires KES and is a Later item.
MINIO_KMS_SECRET_KEY=

# ── Zitadel (identity, SSO) ──────────────────────────────────────────────────
# Symmetric masterkey for Zitadel's encryption keys — MUST be exactly 32 chars.
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
# Password for the dedicated zitadel database user (created on first init).
ZITADEL_DB_PASSWORD=zitadel-dev-password
# First organization and human admin created on first init (zero clicks).
ZITADEL_ORG_NAME=Cogeto
ZITADEL_ADMIN_USERNAME=admin@cogeto.localhost
# Must satisfy Zitadel's default policy: upper + lower + digit + symbol.
ZITADEL_ADMIN_PASSWORD=DevPassword1!
# Expiry of the one-shot bootstrap PAT (SEC-16). zitadel-init REVOKES the PAT
# as soon as provisioning succeeds (except in demo mode, which needs it to
# seed), so this is the backstop, not the control. The dev default stays
# far-future so a fresh clone never breaks on a stale date; the operator
# script generates install date + 14 days per instance.
#ZITADEL_BOOTSTRAP_PAT_EXPIRY=2030-01-01T00:00:00Z

# ── The instance master key (V2.4 item 7.1) ──────────────────────────────────
# Model providers, models and their API keys are configured IN THE INTERFACE
# and stored in the database (Providers and Models in the left rail). The keys
# are encrypted at rest with this master key, which stays HERE and never goes
# into the database: a key that guards a database cannot live inside it.
#
# Generate one with:   openssl rand -base64 32
#
# Optional until something needs encrypting: an instance whose only endpoint is
# a self-hosted server with no authentication never needs one. The moment a
# provider key must be stored, the failure names this variable.
#
# It never changes after that. Rotating it makes every stored provider key
# unreadable, and there is no recovery except re-entering them.
COGETO_MASTER_KEY=

# ── Model providers: MOVED TO THE INTERFACE (V2.4 item 7.1) ──────────────────
# The per-tier provider and model variables, and the per-provider key
# variables, are gone from here. On the FIRST start after upgrading, whatever an
# existing .env still holds is read once and carried into the database as the
# equivalent providers and assignments; from that moment the database is
# authoritative and those variables are IGNORED, not merged, not a fallback.
# They can be deleted after the first successful start. See
# docs/features/models.md and docs/operations/upgrade-notes.md.
#
# What is still environment configuration, because it is a deployment fact
# rather than a model choice:
#
# Per-tier request timeouts for SELF-HOSTED endpoints (ms). Local inference
# answers in seconds to minutes; hosted providers keep no timeout at all.
# Defaults 300000 / 300000 / 120000 / 600000.
#COGETO_MODEL_TIMEOUT_PIPELINE_MS=
#COGETO_MODEL_TIMEOUT_ANSWER_MS=
#COGETO_MODEL_TIMEOUT_EMBEDDINGS_MS=
#COGETO_MODEL_TIMEOUT_VISION_MS=
# maxTokens multiplier applied once a binding is PROBED as a reasoning model
# (a cap sized for an answer is not sized for an answer plus its deliberation).
#COGETO_REASONING_HEADROOM=4
#COGETO_REASONING_PROBE_TIMEOUT_MS=30000
#
# Eval-harness-only (never read by a running instance). The harness resolves
# its configuration from the environment on purpose: it runs in CI against no
# instance database, and pinning the configuration it measures is the point.
#COGETO_PROVIDER_GRADER=
#COGETO_MODEL_GRADER=

# ── Application ──────────────────────────────────────────────────────────────
# pino level for app and worker: trace|debug|info|warn|error|fatal
COGETO_LOG_LEVEL=info

# ── Abuse / DoS limits (FIX-2:) ────────────────────────────
# All optional — sane defaults live in the code, and demoMode auto-tightens the
# aggressive set (the demo override vars below apply only to the public
# sandbox). Defaults are generous for a real user and only bite runaway loops /
# anonymous demo abuse. A rate-limit bucket of 0 is unlimited.
#
# Per-principal request rate (fixed window). Window is shared by all buckets.
#COGETO_RATELIMIT_WINDOW_SECONDS=60
#COGETO_RATELIMIT_CHAT=30           # POST /api/chat (model-cost vector)
#COGETO_RATELIMIT_CAPTURE=60        # POST /api/notes
#COGETO_RATELIMIT_REMEMBER=30       # POST /api/chat/messages/:id/remember
#COGETO_RATELIMIT_UPLOAD=20         # POST /api/files
#COGETO_DEMO_RATELIMIT_CHAT=12
#COGETO_DEMO_RATELIMIT_CAPTURE=60   # must clear the 31-note demo seed burst
#COGETO_DEMO_RATELIMIT_REMEMBER=15
#COGETO_DEMO_RATELIMIT_UPLOAD=10
#
# Per-user daily model budget, enforced in the gateway on user-attributed calls.
# Estimated tokens ~= chars/4. On exhaustion the user gets a 429 / "limit
# reached" until UTC midnight.
#
# Audit 2.0 SEC-18/SEC-10: the counters are DURABLE (Postgres, migration 0038),
# so a restart no longer clears them and the app and worker share one total;
# and the budget now covers WORKER traffic (extraction, verification,
# embedding, dreaming, skill advance, research conclusion), which previously
# ran with no ceiling. The defaults below are raised to match what is now
# counted: they are sized off the ingest quota, so a legitimate day never
# reaches them. A worker job refused by the budget retries with graphile's
# backoff and is visible in the dead-letter view if the cap persists.
#COGETO_MODEL_DAILY_CALLS=10000
#COGETO_MODEL_DAILY_TOKENS=20000000
#COGETO_DEMO_MODEL_DAILY_CALLS=2000
#COGETO_DEMO_MODEL_DAILY_TOKENS=4000000
#
# Per-user daily capture/upload cap (bounds the pipeline work a user can drive).
#COGETO_DAILY_CAPTURE_MAX=1000
#COGETO_DAILY_UPLOAD_MAX=300
#COGETO_DEMO_DAILY_CAPTURE_MAX=500
#COGETO_DEMO_DAILY_UPLOAD_MAX=100
#
# Chat SSE bounds: concurrent streams per principal, idle + max duration.
#COGETO_SSE_MAX_CONCURRENT=3
#COGETO_DEMO_SSE_MAX_CONCURRENT=2
#COGETO_SSE_IDLE_TIMEOUT_SECONDS=60
#COGETO_SSE_MAX_DURATION_SECONDS=180
#
# Document/extraction parse caps: decompressed-text length, chunk count,
# per-parse wall-clock timeout, and max facts admitted per source.
#COGETO_PARSE_MAX_TEXT_CHARS=1000000
#COGETO_PARSE_MAX_CHUNKS=200
#COGETO_PARSE_TIMEOUT_SECONDS=30
#COGETO_EXTRACT_MAX_FACTS=100
# Spreadsheets (V2.1 item 4.1): how many data rows become statements, per sheet
# and per file. A read stopped by either cap is recorded on the source and shown
# in the source drawer, so a partly read file never looks like a whole one.
#COGETO_PARSE_MAX_SHEET_ROWS=5000
#COGETO_PARSE_MAX_FILE_ROWS=20000
# How CSV bytes are decoded when they are not valid UTF-8 and carry no BOM.
# Nothing in the bytes can say which legacy codepage they use; windows-1250 is
# the documented default because it carries the Croatian letters.
#COGETO_PARSE_CSV_FALLBACK_ENCODING=windows-1250
# Reading pages that are pictures (V2.1 item 4.1). The ladder is cheapest-first:
# a page's own text layer, then local OCR (in-instance, nothing leaves the box),
# then a vision model — and only if you assign one. The vision tier is assigned
# in the interface like every other tier (V2.4 item 7.1); leaving it unassigned
# is a complete answer, and pages that need vision are labelled as needing it
# rather than shown as processed and empty.
# How many pages one document, and one user per day, may escalate to vision.
#COGETO_VISION_PAGES_PER_DOCUMENT=20
#COGETO_VISION_PAGES_PER_USER_DAILY=100
# Bulk import: how many import documents may be queued or processing at once
# (1..8). Default 1 keeps one worker slot free for interactive work; an import
# can never starve the instance. Raise on hardware with headroom.
#COGETO_IMPORT_IN_FLIGHT=1
# Findings report (V2.3 item 6.2): where the worker finds the vendored report
# fonts, the canonical brand assets, and the published trust-score artifacts.
# The defaults are the repo-relative paths the Docker image reproduces; only
# set these when running the worker from an unusual working directory. A
# missing trust-scores directory is honest: the report states that no
# published measurement exists for the configuration.
#COGETO_REPORT_FONTS_DIR=project/fonts
#COGETO_REPORT_BRAND_DIR=assets/brand
#COGETO_TRUST_SCORES_DIR=eval/trust-scores
# How long the vision PROBE may take. Separate from the tier timeout above: the
# probe only proves the endpoint accepts an image. Generous by default because a
# remote or cold model takes far longer to warm than to run, and declaring a
# working runtime dead is the worse error.
#COGETO_VISION_PROBE_TIMEOUT_MS=30000

# Reasoning models (probed, never configured). Some models return their
# thinking in a separate reasoning field and leave the answer empty until the
# thinking finishes; whether yours does is detected at boot by sending a
# trivial prompt, because the same weights can be served either way. When
# detected, every maxTokens cap is multiplied by this headroom so the model's
# deliberation cannot silently consume the answer's whole token budget. Only
# applied to bindings that actually reasoned; any other model's requests are
# unchanged.
#COGETO_REASONING_HEADROOM=4
# How long the reasoning PROBE may take. Same rationale as the vision probe's.
#COGETO_REASONING_PROBE_TIMEOUT_MS=30000

# ── Qdrant (vector index) ────────────────────────────────────────────────────
# API key. The default compose stack keeps Qdrant on the internal network
# with no key; SET this (and it is passed to the qdrant service as
# QDRANT__SERVICE__API_KEY) before exposing the console vhosts / a reachable host.
#COGETO_QDRANT_API_KEY=

# ── File upload (O1) ─────────────────────────────────────────────────────────
# Max bytes per upload (default 25 MiB); PDFs and DOCX only.
#COGETO_UPLOAD_MAX_BYTES=26214400
# Presigned download-URL lifetime in seconds (default 300; short-lived).
#COGETO_DOWNLOAD_URL_TTL_SECONDS=300

# ── Inbound email (/0031) ──────────────────────────────────────
# Sender-routed capture: mail from a registered user's address is captured for
# that user; mail from other senders is routed by each user's allowlist. The
# bootstrap admin (operator) account never captures — compose derives this from
# ZITADEL_ADMIN_USERNAME; override only if the admin login differs.
#COGETO_ADMIN_USER_EMAIL=admin@cogeto.localhost
# The instance's unique inbound address; the operator script derives this as
# capture@in.<domain> and the UI shows it with forwarding-setup guidance.
#COGETO_MAIL_INBOUND_ADDRESS=capture@in.localhost
# Shared secret the Haraka container presents on POST /api/email/intake. The
# deploy stack REQUIRES this (no default); the operator script generates one.
# Refused as a known dev value on a non-localhost deployment (secret-preflight).
#COGETO_MAIL_INTAKE_TOKEN=
# Max bytes for a whole inbound message / a single attachment (defaults 25 MiB).
#COGETO_MAIL_MAX_BYTES=26214400
#COGETO_MAIL_ATTACHMENTS_MAX_BYTES=26214400
# Host port the Haraka SMTP listener publishes (default 25) and the in-network
# SMTP address of the mail container.
#COGETO_MAIL_HOST_PORT=25
#COGETO_MAIL_SMTP_ADDRESS=mail:2525
# Sender authentication (SEC-1). When 1 (default), a message is captured for the
# registered user it claims to be from ONLY if the SMTP sender passed SPF, so a
# spoofed From cannot inject that user's memory; a hard SPF fail is refused. Set
# 0 only on a closed test instance without inbound SPF.
#COGETO_MAIL_REQUIRE_SPF=1
# Per-sender accepted-message cap within the intake window (SEC-2) — bounds the
# ingestion/model spend one internet sender can drive. 0 disables the cap.
#COGETO_MAIL_INTAKE_MAX_PER_SENDER=60
#COGETO_MAIL_INTAKE_RATE_WINDOW_SECONDS=3600
# Inbound STARTTLS (GAP-2): paths (inside the mail container's mail-tls volume)
# to the instance cert/key. Absent/unreadable → STARTTLS is not advertised.
#COGETO_MAIL_TLS_CERT=/app/tls/cert.pem
#COGETO_MAIL_TLS_KEY=/app/tls/key.pem

# ── Instance behaviour (FIX-3) ───────────────────────────────────────────────
# Instance timezone — relative dates ("today"/"tomorrow"/"last Monday")
# resolve against local midnight in THIS IANA zone, not UTC, fixing the
# near-midnight off-by-one for the EU audience. Default Europe/Zagreb.
#COGETO_TIMEZONE=Europe/Zagreb
# Zitadel role that gates the operational jobs endpoints. Default 'admin'.
#COGETO_ADMIN_ROLE=admin
# Postgres connection-pool ceiling PER PROCESS. Sized against worker
# concurrency (2); the pipeline holds its idempotency tx open across model calls,
# so each in-flight job pins a connection. Default 10 — raise with concurrency.
#COGETO_PG_POOL_MAX=10
# Browser-reachable object-storage origin used ONLY to sign presigned download
# URLs. Compose defaults it to https://s3.localhost (served by Caddy → minio,
#), which makes O1 downloads work once the *.localhost DNS entry
# is added. Override for a real domain (a browser-reachable S3 origin).
#COGETO_S3_PUBLIC_URL=https://s3.localhost

# Paths the processes read at boot (audit 2.10). Compose sets sensible values;
# override only for unusual layouts (e.g. running entrypoints outside Docker).
#  - COGETO_MIGRATIONS_DIR: where the migrate entrypoint finds the reviewable
#    SQL files (default: project/src/migrations relative to the built code).
#  - COGETO_PROMPTS_DIR: where the model-gateway prompt loader finds the
#    versioned prompt artifacts (default: project/prompts).
#  - COGETO_INSTANCE_KEY_DIR: where the instance ed25519 signing keypair lives
# (deletion receipts, spec §11.1). Compose mounts the instance-keys volume here;
# the migrate init job generates the keypair on first boot.
#COGETO_MIGRATIONS_DIR=
#COGETO_PROMPTS_DIR=
#COGETO_INSTANCE_KEY_DIR=

# ── Ana sandbox (profile demo) ────────────────────────────────
# NEVER set demo mode on a customer instance — the demo publishes a working
# access token for anyone, safe ONLY because the instance holds no real data.
#  - COGETO_DEMO_MODE: force sandbox mode + enable the worker's scheduled reset.
#    (The app auto-detects sandbox mode from the seeded session file even without
#    this, so `docker compose --profile demo up` is enough to populate a sandbox.)
#  - COGETO_PRODUCTION / COGETO_ENV=production: hard-refuse the demo seed/reset.
#  - COGETO_DEMO_RESET_CRON: scheduled-reset cadence (default every 6 hours).
#  - COGETO_DEMO_SESSION_FILE: where the demo Principal's session is published
#    (default /demo-config/session.json; served on /api/config in demo mode).
#COGETO_DEMO_MODE=
#COGETO_PRODUCTION=
#COGETO_ENV=
#COGETO_DEMO_RESET_CRON=0 */6 * * *
#COGETO_DEMO_SESSION_FILE=/demo-config/session.json

# ── Capability visibility (P6.7) ──────────────────────────────
# The capability registry (System → Capabilities, /api/health, the boot banner)
# reports every optional capability's true state. The container cannot see
# which compose profiles are active, so the ACTIVE PROFILE LIST is the signal:
#  - COMPOSE_PROFILES: comma-separated profile list (compose activates these
#    on plain `docker compose up`, and the app reads the mirror
#    COGETO_COMPOSE_PROFILES). The operator script's `cogeto features
#    enable/disable` maintains this line — prefer it over hand-editing.
#  - COGETO_RESEARCH_ENABLED / COGETO_CONSOLES_ENABLED / COGETO_MAIL_ENABLED:
#    explicit enablement for one-off `docker compose --profile ...` runs (CLI
#    flags are invisible to the container).
#  - COGETO_JOBS_OVERDUE_HOURS: nightly-job overdue threshold for the registry
#    (default 26 — one nightly slot plus slack).
#COMPOSE_PROFILES=
#COGETO_RESEARCH_ENABLED=
#COGETO_CONSOLES_ENABLED=
#COGETO_MAIL_ENABLED=
#COGETO_JOBS_OVERDUE_HOURS=26

# ── Redaction mode (spec §12.2, profile redaction;/0023) ────────────
# Local CPU NER pseudonymizes sensitive entities before any external model call
# and re-identifies the response. Enable WITH the profile up:
#   REDACTION_ENABLED=1 docker compose --profile redaction up --build
#  - REDACTION_ENABLED: turn the gateway's redaction stage on (1/true).
#  - REDACTION_URL: sidecar base URL (compose defaults to the service name).
#  - REDACTION_SPACY_MODEL: NER model (en_core_web_lg default; en_core_web_md for
#    ~half the RAM at lower accuracy). If enabled and the sidecar is unreachable,
#    model calls FAIL CLOSED (never sent in plaintext).
# - REDACTION_REQUIRED: fail-closed assertion. Set to 1 to REFUSE boot
#    unless REDACTION_ENABLED is on — bringing the profile up while forgetting the
#    enable flag then fails loudly instead of silently sending plaintext.
#REDACTION_ENABLED=
#REDACTION_URL=http://redaction:8080
#REDACTION_SPACY_MODEL=en_core_web_lg
#REDACTION_REQUIRED=

# ── Web research (Priority 5 Part A, profile research;/0043) ──
# Discovery is the self-hosted SearXNG container; the narrow fetcher pulls the
# selected pages server-side. Bring discovery up with:
#   docker compose --profile research up
#  - COGETO_SEARXNG_URL: SearXNG base URL on the internal network (compose
#    defaults to the service name). Unset/unreachable → research search answers
#    a typed "search unavailable"; nothing else is affected.
#  - SEARXNG_SECRET: SearXNG server secret (dev default in compose;
#    provisioning generates a real one per instance).
#  - COGETO_RESEARCH_RESULT_CAP: max ranked results one discovery query returns.
#  - COGETO_RESEARCH_SEARCH_TIMEOUT_SECONDS / COGETO_RESEARCH_FETCH_TIMEOUT_SECONDS:
#    hard timeouts around one search / one page fetch.
#  - COGETO_RESEARCH_FETCH_MAX_BYTES: response-size cap per fetched page.
#  - COGETO_RESEARCH_PAGES_PER_RUN: max pages one capture request may fetch.
#  - COGETO_RESEARCH_RETAIN_HTML: 1 = additionally retain the sanitised raw
#    HTML as a scoped, encrypted MinIO object (default off — the retained clean
# text + URL are the source of record).
#  - COGETO_DAILY_RESEARCH_SEARCHES / COGETO_DAILY_RESEARCH_PAGES: per-user
#    daily budgets (FIX-2); the demo-namespace variants below tighten them on
#    the sandbox.
#  - COGETO_SKILL_MAX_QUERIES / COGETO_SKILL_PAGES_PER_QUERY: named skills
# — max approved queries in one skill run's plan, and pages
#    the skill engine reads per query (clamped to the per-run page cap). The
#    daily research budgets apply unchanged inside every skill run.
#COGETO_SEARXNG_URL=http://searxng:8080
#SEARXNG_SECRET=
#COGETO_RESEARCH_RESULT_CAP=8
#COGETO_RESEARCH_SEARCH_TIMEOUT_SECONDS=10
#COGETO_RESEARCH_FETCH_TIMEOUT_SECONDS=15
#COGETO_RESEARCH_FETCH_MAX_BYTES=5242880
#COGETO_RESEARCH_PAGES_PER_RUN=5
#COGETO_RESEARCH_RETAIN_HTML=
#COGETO_DAILY_RESEARCH_SEARCHES=40
#COGETO_DAILY_RESEARCH_PAGES=100
#COGETO_DEMO_DAILY_RESEARCH_SEARCHES=10
#COGETO_DEMO_DAILY_RESEARCH_PAGES=20
#COGETO_SKILL_MAX_QUERIES=6
#COGETO_SKILL_PAGES_PER_QUERY=3
