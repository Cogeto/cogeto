# Cogeto edge: TLS termination, SPA static files, reverse proxy.
# Dev instances use Caddy's internal CA (self-signed for localhost); managed
# instances swap this block for a real domain and ACME.

{
	local_certs
}

localhost {
	encode gzip

	# Zitadel paths on the shared origin (OIDC, login UI, console, APIs).
	# NOTE: Zitadel's asset API is /assets/v1/* — the bare /assets/* prefix belongs
	# to the SPA's Vite bundles and must NOT be proxied.
	@zitadel path /.well-known/* /oauth/* /oidc/* /ui/* /idps/* /saml/* /assets/v1/* /auth/v1/* /management/v1/* /admin/v1/* /system/v1/* /device* /zitadel*
	handle @zitadel {
		reverse_proxy zitadel:8080
	}

	# The internal mail-intake endpoint is reachable ONLY from the mail container
	# on the internal network (SEC-2/GAP-5) — never the edge.
	handle /api/email/intake* {
		respond 404
	}

	# The Cogeto API (app process).
	handle /api/* {
		# Security headers on API responses too (audit 2.0 SEC-28). They used to
		# sit only inside the SPA `handle` block, so a JSON error body could be
		# content-sniffed or framed. The policy here is deliberately STRICTER
		# than the SPA's: an API response is data, never a document, so it needs
		# no script, style, image or connect source at all.
		header {
			Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; sandbox"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			X-Frame-Options "DENY"
			# Same short dev-edge HSTS as the SPA block below, and for the same
			# reason: a long policy pinned from a localhost run is sticky.
			Strict-Transport-Security "max-age=300"
		}
		reverse_proxy app:3000
	}

	# The SPA: static files with history-API fallback.
	#
	#: strict Content-Security-Policy applied to the SPA responses ONLY
	# (never the proxied Zitadel login UI or the JSON API, which have their own
	# needs). script-src is 'self' with NO third-party sources and no
	# 'unsafe-inline' — an injected <script src=evil> or inline handler cannot
	# execute. style-src keeps 'unsafe-inline' (React sets element styles at
	# runtime); connect-src is 'self' because the API and Zitadel share this
	# origin. Tradeoff recorded: the SPA holds the bearer token in
	# sessionStorage — accepted for v1, since a strict script-src is the real XSS
	# mitigation and the single-tenant origin bounds exposure.
	handle {
		root * /srv
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			X-Frame-Options "DENY"
			# HSTS (audit 2.0 SEC-15) — DELIBERATELY SHORT on the dev edge (5
			# minutes) and WITHOUT includeSubDomains. HSTS is sticky in the
			# browser: a year-long policy pinned from a localhost dev run would
			# poison plain-http work on other localhost ports for that year, and
			# includeSubDomains would take *.localhost with it. The production
			# edge (project/infra/deploy/Caddyfile) carries the real one-year
			# policy. Never add `preload` to either.
			Strict-Transport-Security "max-age=300"
		}
		try_files {path} /index.html
		file_server
	}
}

# ── Infrastructure consoles moved out ──────────────────────────────────
# The s3.localhost / minio.localhost / qdrant.localhost vhosts USED to live here,
# on the public 80/443 listener — any reachable host could hit them by spoofing
# the Host header (unauthenticated Qdrant, MinIO console). They now live in
# Caddyfile.consoles, served by the `caddy-consoles` service under the
# `consoles` compose profile, bound to 127.0.0.1 only. The default deployment
# exposes EXACTLY this app vhost.
