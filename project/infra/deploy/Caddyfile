# Cogeto customer-instance edge — the production counterpart of
# project/infra/docker/caddy/Caddyfile (dev: localhost with Caddy's internal
# CA). Mounted over the baked-in dev Caddyfile by docker-compose.deploy.yml.
#
# TLS is real Let's Encrypt ACME: Caddy obtains and renews certificates for the
# app domain and the s3.<domain> presign origin automatically as soon as the
# operator's DNS A records resolve to this host (ports 80+443 stay open for the
# HTTP-01 / TLS-ALPN-01 challenges). Until DNS points here, Caddy keeps retrying
# in the background — the stack still comes up.
#
# {$VAR} placeholders are resolved by Caddy from the container environment
# (COGETO_EXTERNAL_DOMAIN, COGETO_ACME_EMAIL, COGETO_MAIL_TLS_SITE — set in
# .env by the operator script).

{
	email {$COGETO_ACME_EMAIL}
}

{$COGETO_EXTERNAL_DOMAIN} {
	encode gzip

	# Zitadel paths on the shared origin (OIDC, login UI, console, APIs).
	# NOTE: Zitadel's asset API is /assets/v1/* — the bare /assets/* prefix belongs
	# to the SPA's Vite bundles and must NOT be proxied.
	@zitadel path /.well-known/* /oauth/* /oidc/* /ui/* /idps/* /saml/* /assets/v1/* /auth/v1/* /management/v1/* /admin/v1/* /system/v1/* /device* /zitadel*
	handle @zitadel {
		reverse_proxy zitadel:8080
	}

	# The internal mail-intake endpoint is reachable
	# ONLY from the mail container on the internal Docker network — NEVER from the
	# public edge (SEC-2/GAP-5). Refuse it here so an internet caller cannot reach
	# it (and cannot make the app buffer a 25 MB body before the token check).
	handle /api/email/intake* {
		respond 404
	}

	# The Cogeto API (app process).
	handle /api/* {
		# Security headers on API responses too (audit 2.0 SEC-28). They used to
		# sit only inside the SPA `handle` block, so a JSON error body could be
		# content-sniffed or framed. The policy here is deliberately STRICTER
		# than the SPA's: an API response is data, never a document, so it needs
		# no script, style, image or connect source at all.
		header {
			Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; sandbox"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			X-Frame-Options "DENY"
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
		}
		reverse_proxy app:3000
	}

	# The SPA: static files with history-API fallback. Same strict CSP as the
	# dev edge: script-src 'self' only, applied to SPA responses only.
	handle {
		root * /srv
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			X-Frame-Options "DENY"
			# HSTS (audit 2.0 SEC-15). One year, and includeSubDomains is safe
			# here because the only subdomains this instance answers on are
			# s3.<domain> and (with email capture enabled) mail.<domain>, both
			# of which Caddy terminates with a real ACME certificate (see the
			# vhosts below). NO `preload`: preload is submitted to a
			# browser-vendor list and is effectively irreversible, so it stays
			# an explicit owner decision, never a default.
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
		}
		try_files {path} /index.html
		file_server
	}
}

# MinIO S3 API — the browser-reachable origin for presigned download URLs
# (COGETO_S3_PUBLIC_URL). Caddy preserves the incoming Host header, which
# MinIO's SigV4 presign check needs. Access is authorized by the presigned URL
# signature itself; the MinIO console is NOT exposed on a customer instance.
#
# SEC-2: the ONLY thing the internet legitimately does here is download a
# presigned object, which is a GET (or HEAD) on a path inside the cogeto
# bucket. Everything else — the MinIO admin API (/minio/admin/*), bucket
# operations, writes — is refused at the edge, so a leaked credential can no
# longer manage MinIO from the internet; MinIO's full API remains reachable
# only on the internal Docker network.
s3.{$COGETO_EXTERNAL_DOMAIN} {
	@presigned_download {
		method GET HEAD
		path /cogeto/*
	}
	handle @presigned_download {
		reverse_proxy minio:9000
	}
	handle {
		respond 403
	}
}

# Inbound-mail TLS (issue #566): the ONLY reason this vhost exists is to make
# the edge obtain and renew a Let's Encrypt certificate for the mail hostname,
# which the mail-tls-sync sidecar then copies into the mail service's own
# volume so Haraka can advertise STARTTLS. Nothing is served here: an HTTPS
# request answers 404, deliberately, because the mail host runs SMTP and no web
# surface at all.
#
# This is the producing half of the original inbound-TLS design. The consuming
# half (the dedicated mail-tls volume, the read-only mount, the entrypoint that
# enables Haraka's tls plugin when a readable certificate is present) shipped
# with the first mail commit and worked; this half was never built, so no
# certificate for the mail hostname was ever issued and inbound mail stayed
# cleartext with nothing saying so.
#
# COGETO_MAIL_TLS_SITE is `mail.<domain>` (the operator script's derive_mx_host,
# the same derivation the DNS checklist prints) when email capture is enabled.
# When it is not, the compose file substitutes the inert address below: an
# explicit `http://` scheme turns Caddy's automatic HTTPS off for that site, and
# `.invalid` is reserved by RFC 2606 and can never resolve, so an instance
# without email capture attempts no ACME order, obtains no certificate,
# provisions no internal CA, and serves exactly what it served before.
#
# The same literal appears here as Caddy's own default, for a caddy run without
# the compose file's substitution. It is NOT the mechanism: Caddy applies a
# `{$VAR:default}` only when the variable is UNSET, and compose always sets
# this one, so an empty value would land here as an empty site address and
# crash-loop the edge. The compose default is what prevents that; a spec keeps
# the two literals identical.
{$COGETO_MAIL_TLS_SITE:http://mail-tls-disabled.invalid} {
	respond 404
}
