{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogeto.eu/schemas/trust-scores/1.2/trust-scores.schema.json",
  "title": "Cogeto trust scores (per release)",
  "description": "The machine-readable quality record Cogeto publishes for every release (eval/trust-scores/vX.Y.Z.json). Rendered by the public trust-score page. Files are immutable once published; corrections ship as notes in the NEXT release. Versioning: additive changes bump the minor, breaking changes the major.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_by",
    "configurations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ],
      "description": "1.1 added contradiction_precision, supersedes_accuracy, supersedes_pairs and rewrite_accuracy (V2.0 item 3.4). 1.2 added the optional `corpora` array, one entry per measured corpus, so a reader can see accuracy on documents specifically rather than one undifferentiated figure (V2.3 item 6.4). Both additive: every published 1.0 and 1.1 file stays valid, and readers must accept all three."
    },
    "generated_by": {
      "type": "object",
      "required": [
        "release",
        "commit",
        "harness",
        "generated_at",
        "backfilled"
      ],
      "additionalProperties": false,
      "properties": {
        "release": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+\\.\\d+(?:-[a-z0-9][a-z0-9-]*)?$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "harness": {
          "type": "string",
          "description": "Prompt/threshold versions the run used (or 'transcribed' provenance for backfilled files)."
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "backfilled": {
          "type": "boolean",
          "description": "True when the numbers were transcribed from recorded runs rather than emitted by the harness at release time."
        }
      }
    },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/configuration"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "One-line human explanations for notable changes. The honesty line: dips ship with explanations, never hidden."
    }
  },
  "$defs": {
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "configuration": {
      "type": "object",
      "required": [
        "id",
        "models",
        "redaction",
        "corpus",
        "metrics"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Stable configuration identifier, e.g. mistral-default, mistral-default-redacted. The website's join key across releases."
        },
        "models": {
          "type": "object",
          "required": [
            "pipeline",
            "answer",
            "embedding"
          ],
          "additionalProperties": false,
          "properties": {
            "pipeline": {
              "type": "string",
              "minLength": 1
            },
            "answer": {
              "type": "string",
              "minLength": 1
            },
            "embedding": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "redaction": {
          "type": "boolean",
          "description": "Whether the local PII-redaction tier was active for this measured configuration."
        },
        "corpus": {
          "type": "object",
          "required": [
            "golden_cases",
            "reconcile_pairs",
            "per_language"
          ],
          "additionalProperties": false,
          "properties": {
            "golden_cases": {
              "$ref": "#/$defs/count"
            },
            "reconcile_pairs": {
              "$ref": "#/$defs/count"
            },
            "chat_cases": {
              "$ref": "#/$defs/count"
            },
            "per_language": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "language",
                  "golden_cases"
                ],
                "additionalProperties": false,
                "properties": {
                  "language": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 8
                  },
                  "golden_cases": {
                    "$ref": "#/$defs/count"
                  },
                  "reconcile_pairs": {
                    "$ref": "#/$defs/count",
                    "description": "Added in 1.1."
                  },
                  "rewrite_cases": {
                    "$ref": "#/$defs/count",
                    "description": "Added in 1.1."
                  }
                }
              }
            },
            "rewrite_cases": {
              "$ref": "#/$defs/count",
              "description": "Query-rewrite routing cases. Added in 1.1."
            }
          }
        },
        "metrics": {
          "type": "object",
          "required": [
            "per_language",
            "aggregate"
          ],
          "additionalProperties": false,
          "properties": {
            "per_language": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "language",
                  "golden_cases",
                  "extraction_precision",
                  "extraction_recall",
                  "verification_agreement",
                  "dedup_accuracy",
                  "contradiction_recall"
                ],
                "additionalProperties": false,
                "properties": {
                  "language": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 8
                  },
                  "golden_cases": {
                    "$ref": "#/$defs/count"
                  },
                  "extraction_precision": {
                    "$ref": "#/$defs/fraction"
                  },
                  "extraction_recall": {
                    "$ref": "#/$defs/fraction"
                  },
                  "verification_agreement": {
                    "$ref": "#/$defs/fraction"
                  },
                  "dedup_accuracy": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/fraction"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Null when the language had no reconciliation pairs."
                  },
                  "contradiction_recall": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/fraction"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reconcile_pairs": {
                    "$ref": "#/$defs/count",
                    "description": "Added in 1.1."
                  },
                  "rewrite_cases": {
                    "$ref": "#/$defs/count",
                    "description": "Added in 1.1."
                  },
                  "contradiction_precision": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/fraction"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Correct contradiction flags / all contradiction flags. Measured since the reconciliation suite existed; PUBLISHED from 1.1 on (V2.0 item 3.4). Null when the language had no reconciliation pairs."
                  },
                  "supersedes_accuracy": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/fraction"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Correct supersession decisions (verdict AND direction) over the pairs where supersession was at stake: the labelled supersedes pairs plus any pair the system superseded that should not have been. Added in 1.1."
                  },
                  "supersedes_pairs": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/count"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The denominator behind supersedes_accuracy. Published because a rate over one case means nothing, whether it passes or fails."
                  },
                  "rewrite_accuracy": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/fraction"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Query-rewrite routing cases passed / all such cases: intent routing, pronoun and ellipsis resolution, temporal classification. Added in 1.1."
                  }
                }
              }
            },
            "aggregate": {
              "type": "object",
              "required": [
                "extraction_precision",
                "extraction_recall",
                "verification_agreement",
                "dedup_accuracy",
                "contradiction_recall"
              ],
              "additionalProperties": false,
              "properties": {
                "extraction_precision": {
                  "$ref": "#/$defs/fraction"
                },
                "extraction_recall": {
                  "$ref": "#/$defs/fraction"
                },
                "verification_agreement": {
                  "$ref": "#/$defs/fraction"
                },
                "dedup_accuracy": {
                  "$ref": "#/$defs/fraction"
                },
                "contradiction_recall": {
                  "$ref": "#/$defs/fraction"
                },
                "contradiction_precision": {
                  "$ref": "#/$defs/fraction",
                  "description": "Added in 1.1."
                },
                "supersedes_accuracy": {
                  "$ref": "#/$defs/fraction",
                  "description": "Added in 1.1."
                },
                "supersedes_pairs": {
                  "$ref": "#/$defs/count",
                  "description": "Added in 1.1."
                },
                "rewrite_accuracy": {
                  "$ref": "#/$defs/fraction",
                  "description": "Added in 1.1."
                }
              }
            },
            "chat": {
              "type": "object",
              "required": [
                "cases",
                "passed",
                "failed"
              ],
              "additionalProperties": false,
              "properties": {
                "cases": {
                  "$ref": "#/$defs/count"
                },
                "passed": {
                  "$ref": "#/$defs/count"
                },
                "failed": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Case ids that failed — published, not hidden."
                }
              }
            }
          }
        },
        "corpora": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/corpus_result"
          },
          "description": "Added in schema 1.2. Optional so every immutable 1.0 and 1.1 file stays valid; every file emitted from V2.3 item 6.4 on carries it."
        }
      }
    },
    "corpus_result": {
      "type": "object",
      "description": "One measured corpus (schema 1.2, V2.3 item 6.4). Published files carry every corpus side by side and NEVER averaged together: `core` is the notes-and-email set the project has measured since v0.8.0, `vertical` the real public documents (regulatory guidance, standards, device datasheets, public tenders, one scan). Their difficulty differs, so their numbers differ, and a reader who cannot tell them apart learns nothing from either. `metrics` and `corpus` above continue to describe the CORE corpus alone, exactly as they did in 1.1, so no published trend line moves because a corpus was added.",
      "required": [
        "id",
        "label",
        "description",
        "extraction_cases",
        "reconcile_pairs",
        "per_language",
        "aggregate"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Stable join key for the trust page: \"core\", \"vertical\"."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human name of the corpus, rendered as the corpus heading."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "One sentence on what the corpus is and why its difficulty differs. Render verbatim; it is the sentence that explains a lower number."
        },
        "extraction_cases": {
          "$ref": "#/$defs/count"
        },
        "reconcile_pairs": {
          "$ref": "#/$defs/count"
        },
        "per_language": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "language",
              "golden_cases",
              "extraction_precision",
              "extraction_recall",
              "verification_agreement",
              "dedup_accuracy",
              "contradiction_recall"
            ],
            "additionalProperties": false,
            "properties": {
              "language": {
                "type": "string",
                "minLength": 2,
                "maxLength": 8
              },
              "golden_cases": {
                "$ref": "#/$defs/count"
              },
              "extraction_precision": {
                "$ref": "#/$defs/fraction"
              },
              "extraction_recall": {
                "$ref": "#/$defs/fraction"
              },
              "verification_agreement": {
                "$ref": "#/$defs/fraction"
              },
              "dedup_accuracy": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/fraction"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Null when the language had no reconciliation pairs."
              },
              "contradiction_recall": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/fraction"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reconcile_pairs": {
                "$ref": "#/$defs/count",
                "description": "Added in 1.1."
              },
              "rewrite_cases": {
                "$ref": "#/$defs/count",
                "description": "Added in 1.1."
              },
              "contradiction_precision": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/fraction"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Correct contradiction flags / all contradiction flags. Measured since the reconciliation suite existed; PUBLISHED from 1.1 on (V2.0 item 3.4). Null when the language had no reconciliation pairs."
              },
              "supersedes_accuracy": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/fraction"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Correct supersession decisions (verdict AND direction) over the pairs where supersession was at stake: the labelled supersedes pairs plus any pair the system superseded that should not have been. Added in 1.1."
              },
              "supersedes_pairs": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/count"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The denominator behind supersedes_accuracy. Published because a rate over one case means nothing, whether it passes or fails."
              },
              "rewrite_accuracy": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/fraction"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Query-rewrite routing cases passed / all such cases: intent routing, pronoun and ellipsis resolution, temporal classification. Added in 1.1."
              }
            }
          },
          "description": "One entry per measured set. The vertical corpus reports a third set beside en and hr: `xl`, the cross-language pairs, which has reconciliation pairs and NO extraction cases, so its extraction figures are the empty-arm convention (1.0) and must render as a dash, never as a perfect score."
        },
        "aggregate": {
          "type": "object",
          "required": [
            "extraction_precision",
            "extraction_recall",
            "verification_agreement",
            "dedup_accuracy",
            "contradiction_recall"
          ],
          "additionalProperties": false,
          "properties": {
            "extraction_precision": {
              "$ref": "#/$defs/fraction"
            },
            "extraction_recall": {
              "$ref": "#/$defs/fraction"
            },
            "verification_agreement": {
              "$ref": "#/$defs/fraction"
            },
            "dedup_accuracy": {
              "$ref": "#/$defs/fraction"
            },
            "contradiction_recall": {
              "$ref": "#/$defs/fraction"
            },
            "contradiction_precision": {
              "$ref": "#/$defs/fraction",
              "description": "Added in 1.1."
            },
            "supersedes_accuracy": {
              "$ref": "#/$defs/fraction",
              "description": "Added in 1.1."
            },
            "supersedes_pairs": {
              "$ref": "#/$defs/count",
              "description": "Added in 1.1."
            },
            "rewrite_accuracy": {
              "$ref": "#/$defs/fraction",
              "description": "Added in 1.1."
            }
          }
        }
      }
    }
  }
}
